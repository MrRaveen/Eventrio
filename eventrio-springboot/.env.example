# Eventrio Spring Boot – environment variables
# Copy this file to .env and fill in your values.
# Used by docker-compose (optional microservice sections) and local development.

# ── Application ──────────────────────────────────────────────────────────────
APP_STATUS=Development
APP_HOME_URL=http://localhost:8080

# ── Database ─────────────────────────────────────────────────────────────────
# Local Docker: mongodb://localhost:27017/EventrioOfficial
# MongoDB Atlas: mongodb+srv://USER:PASS@cluster.example.mongodb.net/EventrioOfficial?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/EventrioOfficial
MONGODB_URI=mongodb://localhost:27017/EventrioOfficial

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Celery (Python parity – optional for Spring AI orchestrator) ─────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Orchestrator / notification channels ─────────────────────────────────────
CHANNEL_NAME_ORCHESTRATOR=orchestrator-channel
NOTIFICATION_CHANNEL=orchestrator-notifications

# ── Google OAuth ─────────────────────────────────────────────────────────────
# In Google Cloud Console → OAuth client → Authorized redirect URIs, add:
#   http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook OAuth ───────────────────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8082/callbacks/meta
FACEBOOK_SUCCESS_REDIRECT_URI=http://localhost:8080/dashboard?tab=social_setup

# ── Mailjet (collaboration invitations) ──────────────────────────────────────
MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MAILJET_SENDER_EMAIL=

# ── Cloudinary (organization media uploads) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Stripe (payments) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend (customer verification emails) ────────────────────────────────────
RESEND_API_KEY=

# ── AI / LLM ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=
MODEL_KEY=
MODEL_DEPLOYMENT=local
# IMG_KEY=

# ── Inter-service URLs (Spring Boot) ─────────────────────────────────────────
USER_SERVICE_URL=http://localhost:8082
ORGANIZATION_SERVICE_URL=http://localhost:8083
EVENT_SERVICE_URL=http://localhost:8084
COLLABORATION_SERVICE_URL=http://localhost:8085
TICKETING_SERVICE_URL=http://localhost:8086
PAYMENT_SERVICE_URL=http://localhost:8087
NOTIFICATION_SERVICE_URL=http://localhost:8088
ORCHESTRATOR_SERVICE_URL=http://localhost:8089

# ── Web service template paths (optional overrides) ──────────────────────────
# EVENTRIO_TEMPLATES_DIR=../templates-source
# EVENTRIO_STATIC_DIR=../../app/static

# ── Development / test fixtures (APP_STATUS=Development) ─────────────────────
TEST_USER_ID=
TEST_ORG_ID=
TEST_EVENT_NAME=
TEST_DES=
TEST_START_TIME=
TEST_END_TIME=
TEST_SCRIPT_CONTEXT_IMG_GEN=
TEST_MOCK_SLIDESHOW_MD=
TEST_PLAN_TEXT=
TEST_TASKS_DATA=
