                    <div class="chat-bubble-ai p-5 flex-1">
                        <p class="text-base font-bold mb-1" style="color:var(--text-primary);">Hello! I'm your AI Event Planner.</p>
                        <p class="text-sm leading-relaxed" style="color:var(--text-secondary);">I can orchestrate entire events from start to finish. What are we planning today?</p>
                        <div class="flex flex-wrap gap-2 mt-4">
                            <button onclick="quickPrompt('Help me plan a product launch for Acme Corp')" class="chip-btn">🚀 Product Launch</button>
                            <button onclick="quickPrompt('I want to host a webinar on Python basics')" class="chip-btn">💻 Technical Webinar</button>
                            <button onclick="quickPrompt('Create a social media campaign for our upcoming gala')" class="chip-btn">🎉 Social Campaign</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Input area -->
        <div class="shrink-0 px-6 pb-6 pt-3">
            <div class="max-w-3xl mx-auto">
                <div class="rounded-xl p-1 input-glow transition-all" style="background:var(--bg-card); border:1px solid var(--border);">
