                        {% if event.industry %}
                            <span class="px-2 py-1 bg-brand-50 text-brand-600 text-[10px] font-black uppercase tracking-widest rounded-md border border-brand-100">{{ event.industry[0] }}</span>
                        {% else %}
                            <span class="px-2 py-1 bg-white text-slate-500 text-[10px] font-black uppercase tracking-widest rounded-md border border-slate-100 italic">GenAI</span>
                        {% endif %}
                        <span class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">{{ event.startDate.strftime('%b %d, %Y') }}</span>
                    </div>
                    <h3 class="text-lg font-black text-slate-800 leading-tight mb-2 {% if not (selected_event and selected_event.id == event.id) %}group-hover:text-brand-600{% endif %} transition-colors">
                        {{ event.name }}
                    </h3>
                    <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                        {{ event.description or 'No description provided.' }}
                    </p>
                    <div class="mt-3 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] text-slate-400 font-bold">Attendee Goal:</span>
                            <span class="text-[10px] text-brand-600 font-black">{{ event.attendeeCountExpected }}</span>
                        </div>
                    </div>
                </a>
                {% endfor %}
            {% else %}
                <div class="text-center py-12 px-6">
                    <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <h3 class="text-sm font-bold text-slate-800 uppercase tracking-widest mb-2">No Upcoming Events</h3>
                    <p class="text-xs text-slate-500 leading-relaxed">Check back later for new innovative gatherings.</p>
                </div>
            {% endif %}
        </div>
    </aside>

    <!-- Right Pane: Event Details -->
    <main class="flex-grow overflow-y-auto bg-white flex flex-col relative">
        {% if selected_event %}
            <!-- Event Header Background -->
            <div class="h-64 md:h-80 relative w-full flex-shrink-0">
                {% if selected_event.mediaLinks %}
                    <img src="{{ selected_event.mediaLinks[0] }}" class="w-full h-full object-cover" alt="Event Banner">
                {% else %}
                    <div class="w-full h-full bg-slate-900 flex items-center justify-center">
                        <div class="text-center">
                            <span class="text-brand-500 text-4xl block mb-2 opacity-50 font-black italic">Eventrio</span>
                            <span class="text-slate-500 text-xs font-bold uppercase tracking-widest">Media Pending</span>
                        </div>
                    </div>
                {% endif %}
                <div class="absolute inset-0 bg-gradient-to-t from-white via-white/20 to-transparent"></div>
            </div>

            <!-- Content Container -->
            <div class="max-w-4xl mx-auto w-full px-6 md:px-12 pb-24 -mt-20 relative z-10">
                <div class="bg-white rounded-3xl p-8 md:p-12 shadow-premium shadow-slate-200/60 border border-slate-100">
                    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
                        <div>
                            <h1 class="text-4xl md:text-5xl font-black text-slate-800 tracking-tighter mb-4">{{ selected_event.name }}</h1>
                            <div class="flex flex-wrap items-center gap-4 text-sm font-bold text-slate-500 uppercase tracking-widest">
                                <span class="flex items-center gap-2">
                                    <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                    {{ selected_event.startDate.strftime('%b %d, %Y') }}
                                </span>
                                <span class="flex items-center gap-2">
                                    <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    {{ selected_event.startDate.strftime('%H:%M') }} - {{ selected_event.endDate.strftime('%H:%M') if selected_event.endDate else 'End TBD' }}
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="prose prose-slate max-w-none mb-12">
                        <h2 class="text-xl font-black text-slate-800 uppercase tracking-widest mb-4">About the Event</h2>
                        <p class="text-slate-600 leading-relaxed text-lg">
                            {{ selected_event.description or 'No detailed description available for this event yet.' }}
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-12">
                        <!-- Topics to Discuss -->
                        <div>
                            <h2 class="text-xl font-black text-slate-800 uppercase tracking-widest mb-6">Key Topics</h2>
                            <ul class="flex flex-col gap-3 max-h-72 overflow-y-auto pr-2" style="scrollbar-width: thin; scrollbar-color: #cbd5e1 transparent;">
                                {% if selected_event.targetingPointsToDiscuss %}
                                    {% for point in selected_event.targetingPointsToDiscuss %}
                                    <li class="flex items-start gap-3 p-3.5 bg-white rounded-2xl border border-slate-100 group hover:border-brand-300 hover:shadow-md transition-all">
                                        <div class="w-5 h-5 rounded-full border-2 border-brand-200 flex-shrink-0 mt-0.5 bg-brand-50 group-hover:bg-brand-500 group-hover:border-brand-500 transition-colors"></div>
                                        <div>
                                            <h4 class="font-bold text-slate-700 text-sm leading-snug group-hover:text-slate-900 transition-colors">
                                                {% if point is mapping and point.get('topic') %}
                                                    {{ point.get('topic') }}
                                                {% elif point is mapping and point.get('point') %}
                                                    {{ point.get('point') }}
                                                {% elif point is string %}
                                                    {{ point }}
                                                {% else %}
                                                    {{ point }}
                                                {% endif %}
                                            </h4>
                                        </div>
                                    </li>
                                    {% endfor %}
                                {% else %}
                                    <p class="text-sm text-slate-400 italic">No key topics published yet.</p>
                                {% endif %}
                            </ul>
                        </div>

                        <!-- Organization Information -->
                        <div>
                            <h2 class="text-xl font-black text-slate-800 uppercase tracking-widest mb-6">Host Organization</h2>
                            <div class="bg-brand-900 text-white p-6 rounded-3xl shadow-premium ">
                                <h4 class="text-lg font-black tracking-tight mb-2">{{ selected_event.orgName }}</h4>
                                <p class="text-[10px] opacity-70 uppercase font-black tracking-widest mb-4">Official Organizer</p>
                                <div class="flex items-center gap-3 text-sm opacity-80">
                                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                    {{ selected_event.orgLocation or 'Location TBD' }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Reserve Button Section -->
                    <div class="mt-16 pt-8 border-t border-slate-100 flex justify-center">
                        <button onclick="openReservationModal()" class="px-12 py-5 bg-brand-600 hover:bg-brand-500 text-white font-black text-xl rounded-2xl shadow-premium shadow-brand-200 transition-all duration-300 transform hover:-translate-y-1 active:scale-95">
                            Reserve Your Spot Now
                        </button>
                    </div>
                </div>
            </div>

            <!-- Reservation Modal -->
            <div id="reservationModal" class="fixed inset-0 z-[100] hidden">
                <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" onclick="closeReservationModal()"></div>
                <div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
                    <div class="bg-white w-full max-w-md rounded-3xl shadow-premium relative z-[101] overflow-hidden pointer-events-auto transform transition-all scale-95 opacity-0 duration-300" id="modalContent">
                        <!-- Step 1: Info -->
                        <div id="resStep1" class="p-8 md:p-10">
                            <h3 class="text-2xl font-black text-slate-800 tracking-tight mb-2">Reserve Your Spot</h3>
                            <p class="text-sm text-slate-500 mb-8 font-medium">We'll send a verification code to your email to confirm your reservation.</p>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1 ml-1">Full Name</label>
                                    <input type="text" id="resName" placeholder="Enter your name" class="w-full px-5 py-3 bg-white border border-slate-200 rounded-2xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all text-sm font-medium">
                                </div>
                                <div>
                                    <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1 ml-1">Email Address</label>
                                    <input type="email" id="resEmail" placeholder="you@example.com" class="w-full px-5 py-3 bg-white border border-slate-200 rounded-2xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all text-sm font-medium">
                                </div>
                                <button onclick="sendVerificationCode()" id="btnSendCode" class="w-full py-4 bg-brand-600 hover:bg-brand-500 text-white font-black rounded-2xl shadow-lg shadow-brand-500/20 transition-all active:scale-95 mt-4">
                                    Send Verification Code
                                </button>
                            </div>
                        </div>

                        <!-- Step 2: Code -->
                        <div id="resStep2" class="p-8 md:p-10 hidden">
                            <button onclick="backToStep1()" class="mb-4 text-xs font-bold text-brand-600 flex items-center gap-1 hover:underline">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                                Back
                            </button>
                            <h3 class="text-2xl font-black text-slate-800 tracking-tight mb-2">Verify Email</h3>
                            <p class="text-sm text-slate-500 mb-8 font-medium">Enter the 6-digit code we sent to your inbox.</p>
                            <div class="space-y-6">
                                <div class="flex justify-center">
                                    <input type="text" id="resCode" maxlength="6" placeholder="000000" class="w-full max-w-[200px] text-center text-3xl font-black tracking-[0.5em] py-4 bg-white border-2 border-slate-100 rounded-2xl focus:border-brand-500 focus:ring-0 transition-all">
                                </div>
                                <button onclick="completeReservation()" id="btnVerify" class="w-full py-4 bg-brand-800 hover:bg-brand-900 text-white font-black rounded-2xl shadow-premium transition-all active:scale-95">
                                    Confirm Reservation
                                </button>
                            </div>
                        </div>

                        <!-- Success State -->
                        <div id="resSuccess" class="p-8 md:p-10 text-center hidden">
                            <div class="w-20 h-20 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-6">
                                <svg class="w-10 h-10 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-black text-slate-800 tracking-tight mb-2">You're In!</h3>
                            <p class="text-sm text-slate-500 mb-8 font-medium">Your reservation has been confirmed. Check your email for details.</p>
                            <button onclick="closeReservationModal()" class="w-full py-4 bg-slate-900 text-white font-black rounded-2xl hover:bg-slate-800 transition-all active:scale-95">
                                Great, thanks!
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                const modal = document.getElementById('reservationModal');
                const modalContent = document.getElementById('modalContent');
                const step1 = document.getElementById('resStep1');
                const step2 = document.getElementById('resStep2');
                const success = document.getElementById('resSuccess');

                function openReservationModal() {
                    modal.classList.remove('hidden');
                    setTimeout(() => {
                        modalContent.classList.remove('scale-95', 'opacity-0');
                        modalContent.classList.add('scale-100', 'opacity-100');
                    }, 50);
                }

                function closeReservationModal() {
                    modalContent.classList.add('scale-95', 'opacity-0');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                        resetModal();
                    }, 300);
                }

                function resetModal() {
                    step1.classList.remove('hidden');
                    step2.classList.add('hidden');
                    success.classList.add('hidden');
                    document.getElementById('resCode').value = '';
                }

                function backToStep1() {
                    step2.classList.add('hidden');
                    step1.classList.remove('hidden');
                }

                async function sendVerificationCode() {
                    const email = document.getElementById('resEmail').value;
                    const name = document.getElementById('resName').value;
                    const btn = document.getElementById('btnSendCode');

                    if (!email || !name) {
                        alert('Please fill in both name and email.');
                        return;
                    }

                    btn.disabled = true;
                    btn.innerText = 'Sending...';

                    try {
                        const response = await fetch(`/customer/get-verification-code/${email}`);
                        const data = await response.json();

                        if (response.ok) {
                            step1.classList.add('hidden');
                            step2.classList.remove('hidden');
                        } else {
                            alert(data.message || 'Failed to send code.');
                        }
                    } catch (error) {
                        alert('Error sending verification code.');
                    } finally {
                        btn.disabled = false;
                        btn.innerText = 'Send Verification Code';
                    }
                }

                async function completeReservation() {
                    const code = document.getElementById('resCode').value;
                    const email = document.getElementById('resEmail').value;
                    const name = document.getElementById('resName').value;
                    const btn = document.getElementById('btnVerify');

                    if (!code || code.length !== 6) {
                        alert('Please enter the 6-digit code.');
                        return;
                    }

                    btn.disabled = true;
                    btn.innerText = 'Verifying...';

                    const payload = {
                        name: name,
                        email: email,
                        eventID: '{{ selected_event.id }}',
                        orgID: '{{ selected_event.orgID }}',
                        verificationCode: code
                    };

                    try {
                        const response = await fetch('/customer/verify-user', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        const data = await response.json();

                        if (response.ok) {
                            step2.classList.add('hidden');
                            success.classList.remove('hidden');
                        } else {
                            alert(data.message || 'Verification failed.');
                        }
                    } catch (error) {
                        alert('Error confirming reservation.');
                    } finally {
                        btn.disabled = false;
                        btn.innerText = 'Confirm Reservation';
                    }
                }
            </script>
        {% else %}
            <!-- No Selection State -->
            <div class="flex-grow flex items-center justify-center p-12 text-center">
                <div class="max-w-md">
                    <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-10 h-10 text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-black text-slate-800 tracking-tight mb-2">Select an event</h2>
                    <p class="text-slate-500 font-medium">Choose an event from the list to view its full schedule and registration details.</p>
                </div>
            </div>
        {% endif %}
    </main>
</div>
{% endblock %}
</file>

