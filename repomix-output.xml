            <div class="url-box">
                <input type="text" id="meeting-url-input" readonly>
                <button id="copy-url-btn">Copy</button>
            </div>
        </div>
    </div>

    <div class="chat-container" id="chat-container">
        <div class="message bot" style="animation-delay: 0.1s;">
            <p>Hello! I'm your Eventrio AI Assistant. How can I help you manage your event today?</p>
        </div>
    </div>

    <div class="input-area">
        <form class="input-container" id="chat-form">
            <input type="text" id="chat-input" placeholder="Ask about events, attendees, or schedules..."
                autocomplete="off">
            <button type="submit" class="send-btn" id="send-btn">
                <svg viewBox="0 0 24 24">
                    <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"></path>
