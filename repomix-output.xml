            <script th:inline="javascript">
                document.addEventListener('DOMContentLoaded', () => {
                    if (/*[[${active_tab}]]*/ 'profile' === 'collabs') {
                        loadCollabs();
                    }
                });

                async function loadCollabs() {
                    const tbody = document.getElementById('collabsTableBody');
                    try {
                        const response = await fetch('/main-dashboard/get-collabs');
                        const result = await response.json();

                        if (result.message === "Success") {
                            const data = result.data;
                            if (data.length === 0) {
                                tbody.innerHTML = `
                                    <tr>
                                        <td colspan="5" class="px-6 py-20 text-center text-slate-400">
                                            <div class="flex flex-col items-center gap-2">
                                                <svg class="w-12 h-12 text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                                                </svg>
                                                <p class="font-medium text-lg">No invitations found</p>
                                                <p class="text-sm">You haven't been invited to any projects yet.</p>
                                            </div>
                                        </td>
                                    </tr>`;
                                return;
                            }

                            tbody.innerHTML = data.map(col => `
                                <tr class="border-b border-slate-100 hover:bg-white/50 transition-colors group">
                                    <td class="px-6 py-4">
                                        <div class="flex flex-col min-w-0">
                                            <span class="font-bold text-slate-800 truncate" title="${col.projectName}">${col.projectName}</span>
                                            <span class="text-xs text-slate-500 flex items-center gap-1">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                                                ${col.orgname}
                                            </span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-2">
                                            <div class="w-7 h-7 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center text-[10px] font-bold">
                                                ${col.ownerName.charAt(0)}
                                            </div>
                                            <span class="text-sm text-slate-600">${col.ownerName}</span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-2 py-1 bg-slate-100 text-slate-600 rounded text-[10px] font-bold uppercase tracking-wider">${col.role}</span>
                                    </td>
                                    <td class="px-6 py-4">
                                        ${col.accept_stat 
                                            ? '<span class="flex items-center gap-1.5 text-xs font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Accepted</span>' 
                                            : '<span class="flex items-center gap-1.5 text-xs font-bold text-amber-600 bg-amber-50 px-2.5 py-1 rounded-full"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>Pending</span>'}
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        ${!col.accept_stat 
                                            ? `<button onclick="handleAccept('${col.docID}', '${col.projectName}')" class="bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg shadow-sm hover:shadow-premium-hover transition-all">Accept</button>`
                                            : `<a href="/event-dashboard/${col.eventID}" class="text-xs font-bold text-brand-600 hover:underline">View Project &rarr;</a>`}
                                    </td>
                                </tr>
                            `).join('');
                        } else {
                            throw new Error(result.data || "Failed to load data");
                        }
                    } catch (error) {
                        console.error(error);
                        tbody.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-red-500 font-medium">Error loading invitations: ${error.message}</td></tr>`;
                    }
                }

                async function handleAccept(docID, projectName) {
                    const result = await Swal.fire({
                        title: 'Accept Invitation?',
                        text: `You are about to join "${projectName}" as a contributor.`,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, Accept',
                        confirmButtonColor: '#9333ea',
                    });

                    if (result.isConfirmed) {
                        Swal.fire({
                            title: 'Processing...',
                            didOpen: () => Swal.showLoading(),
                            allowOutsideClick: false
                        });

                        try {
                            const response = await fetch(`/main-dashboard/accept-collab/${docID}`, {
                                method: 'PUT',
                                headers: { 'Content-Type': 'application/json' }
                            });
                            const data = await response.json();

                            if (data.message === "Success") {
                                await Swal.fire({
                                    title: 'Success!',
                                    text: 'You have joined the project team.',
                                    icon: 'success',
                                    timer: 2000
                                });
                                loadCollabs();
                            } else {
                                throw new Error(data.data || "Action failed");
                            }
                        } catch (error) {
                            Swal.fire({
                                title: 'Error',
                                text: error.message,
                                icon: 'error'
                            });
                        }
                    }
                }
            </script>
