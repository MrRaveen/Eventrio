            <div style="position:absolute; inset:16px; border-radius:50%; background:var(--brand-bg); display:flex; align-items:center; justify-content:center;">
                <svg class="w-6 h-6" style="color:var(--brand-solid);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
        </div>
        <!-- Status text -->
        <div style="text-align:center;">
            <p id="aiLoadingStatus" style="font-size:18px; font-weight:700; color:var(--text-primary); margin:0 0 8px;">Initializing AI Engine...</p>
            <p style="font-size:13px; color:var(--text-muted); margin:0;">This may take a minute. Please don't close this page.</p>
        </div>
        <!-- Progress dots -->
        <div style="display:flex; gap:6px;">
            <div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>
        </div>
    </div>
</div>

<style>
    @keyframes aiSpin { to { transform: rotate(360deg); } }
    .ai-spinner { animation: aiSpin 1s linear infinite; }
</style>

<script>
    // ─── Rotating AI status messages ───
    const AI_MESSAGES = [
        "🧠 Thinking about your event...",
        "📝 Extracting event details...",
        "🗓️ Planning the schedule...",
        "🎨 Creating the event poster...",
        "📄 Generating documentation...",
        "💬 Writing social media posts...",
        "📊 Building the agenda...",
        "⚡ Orchestrating services...",
        "🔗 Setting up Google integrations...",
        "✨ Almost there, finalizing everything..."
    ];
    let _msgInterval = null;

    function showLoadingOverlay() {
        const overlay = document.getElementById('aiLoadingOverlay');
        overlay.style.display = 'block';
        overlay.style.opacity = '1';
        let idx = 0;
        const statusEl = document.getElementById('aiLoadingStatus');
        statusEl.textContent = AI_MESSAGES[0];
        _msgInterval = setInterval(() => {
            idx = (idx + 1) % AI_MESSAGES.length;
            statusEl.style.opacity = '0';
            setTimeout(() => {
                statusEl.textContent = AI_MESSAGES[idx];
                statusEl.style.opacity = '1';
            }, 300);
        }, 3500);
    }

    function hideLoadingOverlay() {
        if (_msgInterval) { clearInterval(_msgInterval); _msgInterval = null; }
        const overlay = document.getElementById('aiLoadingOverlay');
        overlay.style.opacity = '0';
        setTimeout(() => { overlay.style.display = 'none'; }, 400);
    }

    // ─── SSE notification listener ───
    let _evtSource = null;

    function startSSEListener() {
        if (_evtSource) _evtSource.close();
        _evtSource = new EventSource('/notifications/listen');
        _evtSource.onmessage = function(event) {
            try {
                const payload = JSON.parse(event.data);
                hideLoadingOverlay();
                if (_evtSource) { _evtSource.close(); _evtSource = null; }

                const projectID = payload.projectID;
                appendMsg(`<div class="flex items-start gap-4 animate-fadeInUp"><div class="w-10 h-10 rounded-2xl flex items-center justify-center flex-shrink-0" style="background:#10b981;"><svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg></div><div class="chat-bubble-ai px-5 py-4 flex-1"><p class="text-sm font-bold mb-1" style="color:var(--text-primary);">✅ Event generated successfully!</p><p class="text-sm" style="color:var(--text-secondary);">Your AI-powered event is ready. Redirecting to your event dashboard...</p></div></div>`);

                setTimeout(() => {
                    if (projectID) {
                        window.location.href = `/event-ui/event-dashboard/${projectID}`;
                    }
                }, 2000);
            } catch(e) { console.error('SSE parse error', e); }
        };
        _evtSource.onerror = function() {
            console.warn('SSE connection error, will auto-reconnect');
        };
    }

    // ─── Page init ───
    document.addEventListener('DOMContentLoaded', () => {
        const fbSelect = document.getElementById('chatFbPageSelect');
        if (fbSelect) {
            fetch('/main-dashboard/get-fb-pages')
                .then(res => { if (!res.ok) throw new Error(); return res.json(); })
                .then(data => {
                    fbSelect.innerHTML = '<option value="">No need to post</option>';
                    if (!data.error && Array.isArray(data) && data.length > 0) {
                        data.forEach(page => {
                            const opt = document.createElement('option');
                            opt.value = page.page_id;
                            opt.textContent = page.page_name;
                            fbSelect.appendChild(opt);
                        });
                    }
                })
                .catch(() => { fbSelect.innerHTML = '<option value="">No need to post</option>'; });
        }

        document.getElementById('aiLoadingStatus').style.transition = 'opacity 0.3s ease';
    });

    function handleKey(e) {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendGlobalChat(); }
    }

    function quickPrompt(text) {
        document.getElementById('globalChatInput').value = text;
        sendGlobalChat();
    }

    function appendMsg(html) {
        const win = document.getElementById('globalChatWindow');
        const inner = win.querySelector('.max-w-3xl');
        const el = document.createElement('div');
        el.innerHTML = html.trim();
        inner.appendChild(el.firstElementChild);
        win.scrollTop = win.scrollHeight;
    }

    function sendGlobalChat() {
        const input = document.getElementById('globalChatInput');
        const orgSelect = document.getElementById('chatOrgSelect');
        const text = input.value.trim();
        if (!text) return;
        if (!orgSelect || !orgSelect.value) {
            Swal.fire({ icon:'warning', title:'Select Organization', text:'Please select an organization before generating.', confirmButtonColor:'#6E50F7' });
            return;
        }

        appendMsg(`<div class="flex justify-end animate-fadeInUp"><div class="chat-bubble-user px-4 py-3 max-w-[80%] text-sm font-medium">${text.replace(/\n/g,'<br>')}</div></div>`);
        input.value = '';
        input.style.height = 'auto';

        const fbSelect = document.getElementById('chatFbPageSelect');
        const pageId = fbSelect && fbSelect.value ? fbSelect.value : null;

        // Show loading overlay and start SSE listener BEFORE the fetch
        showLoadingOverlay();
        startSSEListener();

        fetch('/ai/generate-event', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prompt: text, orgID: orgSelect.value, page_id: pageId })
        })
        .then(res => res.json())
        .then(data => {
            if (data.error) {
                hideLoadingOverlay();
                if (_evtSource) { _evtSource.close(); _evtSource = null; }
                appendMsg(`<div class="flex justify-center animate-fadeInUp"><div class="px-4 py-2 rounded-lg text-xs font-semibold" style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);color:#ef4444;">Error: ${data.error}</div></div>`);
            }
            // If success (202), keep waiting — SSE will handle the completion
        })
        .catch(() => {
            hideLoadingOverlay();
            if (_evtSource) { _evtSource.close(); _evtSource = null; }
            appendMsg(`<div class="flex justify-center animate-fadeInUp"><div class="px-4 py-2 rounded-lg text-xs font-semibold" style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);color:#ef4444;">Connection failed. Please try again.</div></div>`);
        });
    }

    document.getElementById('globalChatInput').addEventListener('input', function() {
        this.style.height = 'auto';
        this.style.height = this.scrollHeight + 'px';
    });
</script>
{% endblock %}
</file>

<file path="eventrio-springboot/templates-source/base.html">
<!DOCTYPE html>
<html lang="en" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eventrio — Professional Event Orchestration</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
                    colors: {
                        brand: {
                            50:'#F3F0FF', 100:'#E5DFFF', 200:'#C9BFFF', 300:'#A899FF',
                            400:'#8A72FF', 500:'#6E50F7', 600:'#5538E8', 700:'#4229CC',
                            800:'#2E1DA0', 900:'#1C1175', 950:'#0D0840',
                        }
                    }
                }
            }
        }
    </script>

    <!-- ═══ THEME SYSTEM ═══ -->
    <script>
        // Apply saved theme instantly to prevent flash
        (function() {
            var t = localStorage.getItem('eventrio-theme') || 'light';
            document.documentElement.className = t;
        })();
    </script>

    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; margin: 0; }

        /* ════════════════════════════════════════════
           CSS CUSTOM PROPERTIES — LIGHT THEME (default)
           ════════════════════════════════════════════ */
        :root, html.light {
            --bg-body:        #F8F8FA;
            --bg-sidebar:     #FFFFFF;
            --bg-card:        #FFFFFF;
            --bg-surface:     #F3F3F6;
            --bg-input:       #F5F5F7;
            --bg-hover:       #EDEDF2;
            --bg-modal:       #FFFFFF;
            --bg-header:      rgba(255,255,255,0.85);

            --border:         #E5E5EA;
            --border-subtle:  #ECECF0;

            --text-primary:   #1A1A2E;
            --text-secondary: #6B6B80;
            --text-muted:     #9D9DB0;
            --text-inverse:   #FFFFFF;

            --brand-bg:       #F3F0FF;
            --brand-text:     #5538E8;
            --brand-border:   #E5DFFF;
            --brand-solid:    #6E50F7;
            --brand-solid-h:  #5538E8;

            --nav-active-bg:      #F3F0FF;
            --nav-active-text:    #5538E8;
            --nav-active-border:  #C9BFFF;
            --nav-text:           #6B6B80;
            --nav-hover-bg:       #F3F3F6;

            --shadow-sm:  0 1px 3px rgba(0,0,0,0.06);
            --shadow-md:  0 4px 16px rgba(0,0,0,0.08);
            --shadow-lg:  0 8px 32px rgba(0,0,0,0.1);
            --shadow-modal: 0 20px 60px rgba(0,0,0,0.15);

            --overlay:    rgba(0,0,0,0.4);
            color-scheme: light;
        }

        /* ════════════════════════════════════════════
           CSS CUSTOM PROPERTIES — DARK THEME
           ════════════════════════════════════════════ */
        html.dark {
            --bg-body:        #0F0F17;
            --bg-sidebar:     #0D0D15;
            --bg-card:        #1A1A26;
            --bg-surface:     #15151F;
            --bg-input:       #1E1E2C;
            --bg-hover:       #22222F;
            --bg-modal:       #1A1A26;
            --bg-header:      rgba(15,15,23,0.85);

            --border:         #2A2A3A;
            --border-subtle:  #222232;

            --text-primary:   #E8E8F0;
            --text-secondary: #9898AC;
            --text-muted:     #5C5C72;
            --text-inverse:   #0F0F17;

            --brand-bg:       rgba(110,80,247,0.12);
            --brand-text:     #A899FF;
            --brand-border:   rgba(110,80,247,0.25);
            --brand-solid:    #6E50F7;
            --brand-solid-h:  #7E64F8;

            --nav-active-bg:      rgba(110,80,247,0.14);
            --nav-active-text:    #C9BFFF;
            --nav-active-border:  rgba(110,80,247,0.3);
            --nav-text:           #7A7A92;
            --nav-hover-bg:       rgba(255,255,255,0.05);

            --shadow-sm:  0 1px 3px rgba(0,0,0,0.3);
            --shadow-md:  0 4px 16px rgba(0,0,0,0.4);
            --shadow-lg:  0 8px 32px rgba(0,0,0,0.5);
            --shadow-modal: 0 20px 60px rgba(0,0,0,0.6);

            --overlay:    rgba(0,0,0,0.6);
            color-scheme: dark;
        }

        /* ════════════════════════════════════════════
           BASE STYLES
           ════════════════════════════════════════════ */
        body {
            background: var(--bg-body);
            color: var(--text-primary);
        }

        /* Scrollbars */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }

        /* Selection */
        ::selection { background: var(--brand-bg); color: var(--brand-text); }

        /* ════════════════════════════════════════════
           SIDEBAR NAV LINKS
           ════════════════════════════════════════════ */
        .nav-link {
            display: flex; align-items: center; gap: 10px;
            padding: 9px 14px; border-radius: 8px;
            font-size: 13.5px; font-weight: 600;
            color: var(--nav-text);
            border: 1px solid transparent;
            transition: all 0.15s ease;
            text-decoration: none;
        }
        .nav-link svg { flex-shrink: 0; }
        .nav-link:hover {
            color: var(--text-primary);
            background: var(--nav-hover-bg);
        }
        .nav-link.active {
            color: var(--nav-active-text);
            background: var(--nav-active-bg);
            border-color: var(--nav-active-border);
        }

        /* ════════════════════════════════════════════
           COMMON UI COMPONENTS
           ════════════════════════════════════════════ */
        .ev-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: var(--shadow-sm);
        }
        .ev-card:hover {
            border-color: var(--brand-border);
            box-shadow: var(--shadow-md);
        }

        .ev-input {
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-primary);
            padding: 8px 14px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.15s;
        }
        .ev-input::placeholder { color: var(--text-muted); }
        .ev-input:focus { border-color: var(--brand-solid); }

        .ev-select {
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-primary);
            padding: 6px 12px;
            font-size: 14px;
            outline: none;
            cursor: pointer;
            transition: border-color 0.15s;
        }
        .ev-select:focus { border-color: var(--brand-solid); }

        .ev-btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 6px;
            padding: 10px 20px; border-radius: 8px;
            font-size: 14px; font-weight: 600;
            border: none; cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
        }
        .ev-btn-primary {
            background: var(--brand-solid);
            color: #fff;
        }
        .ev-btn-primary:hover { background: var(--brand-solid-h); }
        .ev-btn-ghost {
            background: transparent;
            color: var(--text-primary);
            border: 1px solid var(--border);
        }
        .ev-btn-ghost:hover { background: var(--bg-hover); }

        .ev-badge {
            display: inline-flex; align-items: center; gap: 4px;
            padding: 3px 10px; border-radius: 6px;
            font-size: 11px; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.04em;
        }
        .ev-badge-brand {
            background: var(--brand-bg);
            color: var(--brand-text);
            border: 1px solid var(--brand-border);
        }

        .ev-modal-overlay {
            background: var(--overlay);
            backdrop-filter: blur(4px);
        }
        .ev-modal {
            background: var(--bg-modal);
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: var(--shadow-modal);
            color: var(--text-primary);
        }

        .ev-table th {
            background: var(--bg-surface);
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border);
        }
        .ev-table td {
            border-bottom: 1px solid var(--border-subtle);
        }
        .ev-table tr:hover td {
            background: var(--bg-hover);
        }

        .text-primary   { color: var(--text-primary) !important; }
        .text-secondary  { color: var(--text-secondary) !important; }
        .text-muted      { color: var(--text-muted) !important; }
        .text-brand      { color: var(--brand-text) !important; }
        .bg-card         { background: var(--bg-card) !important; }
        .bg-surface      { background: var(--bg-surface) !important; }
        .border-theme    { border-color: var(--border) !important; }

        /* Theme toggle button */
        .theme-toggle {
            display: flex; align-items: center; gap: 8px;
            padding: 8px 12px; border-radius: 8px;
            cursor: pointer; border: none;
            background: var(--bg-surface);
            color: var(--text-secondary);
            font-size: 12px; font-weight: 600;
            transition: all 0.15s;
            width: 100%;
        }
        .theme-toggle:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
        }
        .theme-toggle svg { width: 16px; height: 16px; flex-shrink: 0; }

        /* Fade in */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .animate-fadeInUp { animation: fadeInUp 0.5s ease forwards; }
    </style>
</head>
<body class="min-h-screen antialiased">
    {% block content %}
    {% endblock %}
    {% include 'components/confirm_modal.html' %}
    {% block scripts %}
    {% endblock %}

    <!-- Theme toggle script -->
    <script>
        function toggleTheme() {
            var html = document.documentElement;
            var next = html.classList.contains('dark') ? 'light' : 'dark';
            html.className = next;
            localStorage.setItem('eventrio-theme', next);
            // Update toggle icons
            document.querySelectorAll('.theme-icon-light').forEach(el => el.style.display = next === 'light' ? 'none' : 'block');
            document.querySelectorAll('.theme-icon-dark').forEach(el => el.style.display = next === 'dark' ? 'none' : 'block');
        }
        // Init icons on load
        document.addEventListener('DOMContentLoaded', function() {
            var t = document.documentElement.className;
            document.querySelectorAll('.theme-icon-light').forEach(el => el.style.display = t === 'light' ? 'none' : 'block');
            document.querySelectorAll('.theme-icon-dark').forEach(el => el.style.display = t === 'dark' ? 'none' : 'block');
        });
    </script>
</body>
</html>
</file>

<file path="eventrio-springboot/templates-source/browse_events.html">
{% extends 'base.html' %}
{% block content %}
<div class="flex flex-col md:flex-row h-screen w-full overflow-hidden">
    <!-- Left Pane: Search and Event List (30% width on md screens) -->
    <aside class="w-full md:w-1/3 lg:w-1/4 bg-white border-r border-slate-200 flex flex-col h-full bg-white shadow-sm">
        <!-- Search Header -->
        <div class="p-6 border-b border-slate-100 space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="text-xl font-black text-slate-800 tracking-tight">Explore Events</h2>
                <a href="{{ url_for('ui_endpoints.landing') }}" class="text-xs font-bold text-brand-600 hover:text-brand-700 transition-colors uppercase tracking-widest">Home</a>
            </div>
            <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </span>
                <input type="text" placeholder="Search for events..." 
                    class="block w-full pl-10 pr-4 py-2 bg-white border border-slate-200 rounded-2xl focus:ring-brand-500 focus:border-brand-500 text-sm transition-all shadow-sm">
            </div>
        </div>

        <!-- Event List -->
        <div class="flex-grow overflow-y-auto p-4 space-y-4 bg-white/30">
            {% if events %}
                {% for event in events %}
                <a href="{{ url_for('ui_endpoints.browse_events', selected=event.id|string) }}" 
                   class="block p-5 rounded-2xl transition-all cursor-pointer group {% if selected_event and selected_event.id == event.id %}bg-white border-2 border-brand-500 shadow-lg ring-4 ring-brand-500/5 scale-[1.02]{% else %}bg-white border border-slate-200 hover:border-slate-300 hover:shadow-md{% endif %}">
                    <div class="flex justify-between items-start mb-2">
                        {% if event.industry %}
                            <span class="px-2 py-1 bg-brand-50 text-brand-600 text-[10px] font-black uppercase tracking-widest rounded-md border border-brand-100">{{ event.industry[0] }}</span>
                        {% else %}
                            <span class="px-2 py-1 bg-white text-slate-500 text-[10px] font-black uppercase tracking-widest rounded-md border border-slate-100 italic">GenAI</span>
                        {% endif %}
                        <span class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">{{ event.startDate.strftime('%b %d, %Y') }}</span>
                    </div>
                    <h3 class="text-lg font-black text-slate-800 leading-tight mb-2 {% if not (selected_event and selected_event.id == event.id) %}group-hover:text-brand-600{% endif %} transition-colors">
                        {{ event.name }}
                    </h3>
                    <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                        {{ event.description or 'No description provided.' }}
                    </p>
                    <div class="mt-3 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] text-slate-400 font-bold">Attendee Goal:</span>
                            <span class="text-[10px] text-brand-600 font-black">{{ event.attendeeCountExpected }}</span>
                        </div>
                    </div>
                </a>
                {% endfor %}
            {% else %}
                <div class="text-center py-12 px-6">
                    <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <h3 class="text-sm font-bold text-slate-800 uppercase tracking-widest mb-2">No Upcoming Events</h3>
                    <p class="text-xs text-slate-500 leading-relaxed">Check back later for new innovative gatherings.</p>
                </div>
            {% endif %}
        </div>
    </aside>

    <!-- Right Pane: Event Details -->
    <main class="flex-grow overflow-y-auto bg-white flex flex-col relative">
        {% if selected_event %}
            <!-- Event Header Background -->
            <div class="h-64 md:h-80 relative w-full flex-shrink-0">
                {% if selected_event.mediaLinks %}
                    <img src="{{ selected_event.mediaLinks[0] }}" class="w-full h-full object-cover" alt="Event Banner">
                {% else %}
                    <div class="w-full h-full bg-slate-900 flex items-center justify-center">
                        <div class="text-center">
                            <span class="text-brand-500 text-4xl block mb-2 opacity-50 font-black italic">Eventrio</span>
                            <span class="text-slate-500 text-xs font-bold uppercase tracking-widest">Media Pending</span>
                        </div>
                    </div>
                {% endif %}
                <div class="absolute inset-0 bg-gradient-to-t from-white via-white/20 to-transparent"></div>
            </div>

            <!-- Content Container -->
            <div class="max-w-4xl mx-auto w-full px-6 md:px-12 pb-24 -mt-20 relative z-10">
                <div class="bg-white rounded-3xl p-8 md:p-12 shadow-premium shadow-slate-200/60 border border-slate-100">
                    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
                        <div>
                            <h1 class="text-4xl md:text-5xl font-black text-slate-800 tracking-tighter mb-4">{{ selected_event.name }}</h1>
                            <div class="flex flex-wrap items-center gap-4 text-sm font-bold text-slate-500 uppercase tracking-widest">
                                <span class="flex items-center gap-2">
                                    <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                    {{ selected_event.startDate.strftime('%b %d, %Y') }}
                                </span>
                                <span class="flex items-center gap-2">
                                    <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    {{ selected_event.startDate.strftime('%H:%M') }} - {{ selected_event.endDate.strftime('%H:%M') if selected_event.endDate else 'End TBD' }}
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="prose prose-slate max-w-none mb-12">
                        <h2 class="text-xl font-black text-slate-800 uppercase tracking-widest mb-4">About the Event</h2>
                        <p class="text-slate-600 leading-relaxed text-lg">
                            {{ selected_event.description or 'No detailed description available for this event yet.' }}
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-12">
                        <!-- Topics to Discuss -->
                        <div>
                            <h2 class="text-xl font-black text-slate-800 uppercase tracking-widest mb-6">Key Topics</h2>
                            <ul class="flex flex-col gap-3 max-h-72 overflow-y-auto pr-2" style="scrollbar-width: thin; scrollbar-color: #cbd5e1 transparent;">
                                {% if selected_event.targetingPointsToDiscuss %}
                                    {% for point in selected_event.targetingPointsToDiscuss %}
                                    <li class="flex items-start gap-3 p-3.5 bg-white rounded-2xl border border-slate-100 group hover:border-brand-300 hover:shadow-md transition-all">
                                        <div class="w-5 h-5 rounded-full border-2 border-brand-200 flex-shrink-0 mt-0.5 bg-brand-50 group-hover:bg-brand-500 group-hover:border-brand-500 transition-colors"></div>
                                        <div>
                                            <h4 class="font-bold text-slate-700 text-sm leading-snug group-hover:text-slate-900 transition-colors">
                                                {% if point is mapping and point.get('topic') %}
                                                    {{ point.get('topic') }}
                                                {% elif point is mapping and point.get('point') %}
                                                    {{ point.get('point') }}
                                                {% elif point is string %}
                                                    {{ point }}
                                                {% else %}
                                                    {{ point }}
                                                {% endif %}
                                            </h4>
                                        </div>
                                    </li>
                                    {% endfor %}
                                {% else %}
                                    <p class="text-sm text-slate-400 italic">No key topics published yet.</p>
                                {% endif %}
                            </ul>
                        </div>

                        <!-- Organization Information -->
                        <div>
                            <h2 class="text-xl font-black text-slate-800 uppercase tracking-widest mb-6">Host Organization</h2>
                            <div class="bg-brand-900 text-white p-6 rounded-3xl shadow-premium ">
                                <h4 class="text-lg font-black tracking-tight mb-2">{{ selected_event.orgName }}</h4>
                                <p class="text-[10px] opacity-70 uppercase font-black tracking-widest mb-4">Official Organizer</p>
                                <div class="flex items-center gap-3 text-sm opacity-80">
                                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                    {{ selected_event.orgLocation or 'Location TBD' }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Reserve Button Section -->
                    <div class="mt-16 pt-8 border-t border-slate-100 flex justify-center">
                        <button onclick="openReservationModal()" class="px-12 py-5 bg-brand-600 hover:bg-brand-500 text-white font-black text-xl rounded-2xl shadow-premium shadow-brand-200 transition-all duration-300 transform hover:-translate-y-1 active:scale-95">
                            Reserve Your Spot Now
                        </button>
                    </div>
                </div>
            </div>

            <!-- Reservation Modal -->
            <div id="reservationModal" class="fixed inset-0 z-[100] hidden">
                <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" onclick="closeReservationModal()"></div>
                <div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
                    <div class="bg-white w-full max-w-md rounded-3xl shadow-premium relative z-[101] overflow-hidden pointer-events-auto transform transition-all scale-95 opacity-0 duration-300" id="modalContent">
                        <!-- Step 1: Info -->
                        <div id="resStep1" class="p-8 md:p-10">
                            <h3 class="text-2xl font-black text-slate-800 tracking-tight mb-2">Reserve Your Spot</h3>
                            <p class="text-sm text-slate-500 mb-8 font-medium">We'll send a verification code to your email to confirm your reservation.</p>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1 ml-1">Full Name</label>
                                    <input type="text" id="resName" placeholder="Enter your name" class="w-full px-5 py-3 bg-white border border-slate-200 rounded-2xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all text-sm font-medium">
                                </div>
                                <div>
                                    <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1 ml-1">Email Address</label>
                                    <input type="email" id="resEmail" placeholder="you@example.com" class="w-full px-5 py-3 bg-white border border-slate-200 rounded-2xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all text-sm font-medium">
                                </div>
                                <button onclick="sendVerificationCode()" id="btnSendCode" class="w-full py-4 bg-brand-600 hover:bg-brand-500 text-white font-black rounded-2xl shadow-lg shadow-brand-500/20 transition-all active:scale-95 mt-4">
                                    Send Verification Code
                                </button>
                            </div>
                        </div>

                        <!-- Step 2: Code -->
                        <div id="resStep2" class="p-8 md:p-10 hidden">
                            <button onclick="backToStep1()" class="mb-4 text-xs font-bold text-brand-600 flex items-center gap-1 hover:underline">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                                Back
                            </button>
                            <h3 class="text-2xl font-black text-slate-800 tracking-tight mb-2">Verify Email</h3>
                            <p class="text-sm text-slate-500 mb-8 font-medium">Enter the 6-digit code we sent to your inbox.</p>
                            <div class="space-y-6">
                                <div class="flex justify-center">
                                    <input type="text" id="resCode" maxlength="6" placeholder="000000" class="w-full max-w-[200px] text-center text-3xl font-black tracking-[0.5em] py-4 bg-white border-2 border-slate-100 rounded-2xl focus:border-brand-500 focus:ring-0 transition-all">
                                </div>
                                <button onclick="completeReservation()" id="btnVerify" class="w-full py-4 bg-brand-800 hover:bg-brand-900 text-white font-black rounded-2xl shadow-premium transition-all active:scale-95">
                                    Confirm Reservation
                                </button>
                            </div>
                        </div>

                        <!-- Success State -->
                        <div id="resSuccess" class="p-8 md:p-10 text-center hidden">
                            <div class="w-20 h-20 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-6">
                                <svg class="w-10 h-10 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-black text-slate-800 tracking-tight mb-2">You're In!</h3>
                            <p class="text-sm text-slate-500 mb-8 font-medium">Your reservation has been confirmed. Check your email for details.</p>
                            <button onclick="closeReservationModal()" class="w-full py-4 bg-slate-900 text-white font-black rounded-2xl hover:bg-slate-800 transition-all active:scale-95">
                                Great, thanks!
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                const modal = document.getElementById('reservationModal');
                const modalContent = document.getElementById('modalContent');
                const step1 = document.getElementById('resStep1');
                const step2 = document.getElementById('resStep2');
                const success = document.getElementById('resSuccess');

                function openReservationModal() {
                    modal.classList.remove('hidden');
                    setTimeout(() => {
                        modalContent.classList.remove('scale-95', 'opacity-0');
                        modalContent.classList.add('scale-100', 'opacity-100');
                    }, 50);
                }

                function closeReservationModal() {
                    modalContent.classList.add('scale-95', 'opacity-0');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                        resetModal();
                    }, 300);
                }

                function resetModal() {
                    step1.classList.remove('hidden');
                    step2.classList.add('hidden');
                    success.classList.add('hidden');
                    document.getElementById('resCode').value = '';
                }

                function backToStep1() {
                    step2.classList.add('hidden');
                    step1.classList.remove('hidden');
                }

                async function sendVerificationCode() {
                    const email = document.getElementById('resEmail').value;
                    const name = document.getElementById('resName').value;
                    const btn = document.getElementById('btnSendCode');

                    if (!email || !name) {
                        alert('Please fill in both name and email.');
                        return;
                    }

                    btn.disabled = true;
                    btn.innerText = 'Sending...';

                    try {
                        const response = await fetch(`/customer/get-verification-code/${email}`);
                        const data = await response.json();

                        if (response.ok) {
                            step1.classList.add('hidden');
                            step2.classList.remove('hidden');
                        } else {
                            alert(data.message || 'Failed to send code.');
                        }
                    } catch (error) {
                        alert('Error sending verification code.');
                    } finally {
                        btn.disabled = false;
                        btn.innerText = 'Send Verification Code';
                    }
                }

                async function completeReservation() {
                    const code = document.getElementById('resCode').value;
                    const email = document.getElementById('resEmail').value;
                    const name = document.getElementById('resName').value;
                    const btn = document.getElementById('btnVerify');

                    if (!code || code.length !== 6) {
                        alert('Please enter the 6-digit code.');
                        return;
                    }

                    btn.disabled = true;
                    btn.innerText = 'Verifying...';

                    const payload = {
                        name: name,
                        email: email,
                        eventID: '{{ selected_event.id }}',
                        orgID: '{{ selected_event.orgID }}',
                        verificationCode: code
                    };

                    try {
                        const response = await fetch('/customer/verify-user', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        const data = await response.json();

                        if (response.ok) {
                            step2.classList.add('hidden');
                            success.classList.remove('hidden');
                        } else {
                            alert(data.message || 'Verification failed.');
                        }
                    } catch (error) {
                        alert('Error confirming reservation.');
                    } finally {
                        btn.disabled = false;
                        btn.innerText = 'Confirm Reservation';
                    }
                }
            </script>
        {% else %}
            <!-- No Selection State -->
            <div class="flex-grow flex items-center justify-center p-12 text-center">
                <div class="max-w-md">
                    <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-10 h-10 text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-black text-slate-800 tracking-tight mb-2">Select an event</h2>
                    <p class="text-slate-500 font-medium">Choose an event from the list to view its full schedule and registration details.</p>
                </div>
            </div>
        {% endif %}
    </main>
</div>
{% endblock %}
</file>

<file path="eventrio-springboot/templates-source/dashboard.html">
{% extends 'base.html' %}
{% block content %}
<div class="flex h-screen w-full overflow-hidden" style="background:var(--bg-body);">

