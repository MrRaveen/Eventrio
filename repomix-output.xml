                        "content": prompt
                    }
                ],
                response_model=fbPostOutput,
                max_retries=3, 
            )
            
            return {"facebook_post_result": extracted_data.post_content}
            
        except APIError:
            raise
        except Exception as e:
            raise APIError("500", f"Error generating Facebook post: {str(e)}")
