<file path="app/templates/profile_setup.html">
{% extends 'base.html' %}

{% block content %}
<div class="min-h-screen bg-white py-12 px-4 sm:px-6 lg:px-8 transition-colors duration-200">
    <div class="max-w-3xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-12 animate-in fade-in slide-in-from-top-4 duration-700">
            <h1 class="text-4xl font-black text-brand-600 tracking-tight mb-3">Complete Your Profile</h1>
            <p class="text-slate-500 text-lg">Help us tailor the experience to your needs</p>
        </div>

        <form id="profileForm" action="{{ url_for('auth_login.setup_profile') }}" method="POST" class="space-y-8">
            <!-- Section 1: Industry & Role -->
            <div class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm animate-in fade-in slide-in-from-bottom-4 duration-700 delay-150">
                <h2 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-brand-100 text-brand-600 text-sm font-black">1</span>
                    Your Professional Context
                </h2>

                <div class="space-y-8">
                    <!-- Industry -->
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-4 uppercase tracking-wider">Which industries do you operate in?</label>
                        <div class="flex flex-wrap gap-3">
                            {% for industry in industries %}
                            <label class="relative group cursor-pointer">
                                <input type="checkbox" name="industry" value="{{ industry }}" class="peer sr-only">
                                <div class="px-5 py-2.5 rounded-full border border-slate-200 bg-white text-slate-600 font-medium transition-all group-hover:border-brand-300 peer-checked:bg-brand-600 peer-checked:text-white peer-checked:border-brand-600 peer-checked:shadow-lg peer-checked:shadow-brand-500/20">
                                    {{ industry }}
                                </div>
                            </label>
                            {% endfor %}
                        </div>
                    </div>

                    <!-- Role -->
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-4 uppercase tracking-wider">What is your primary role?</label>
                        <div class="flex flex-wrap gap-3">
                            {% for role in roles %}
                            <label class="relative group cursor-pointer">
                                <input type="checkbox" name="role" value="{{ role }}" class="peer sr-only">
                                <div class="px-5 py-2.5 rounded-full border border-slate-200 bg-white text-slate-600 font-medium transition-all group-hover:border-brand-300 peer-checked:bg-brand-600 peer-checked:text-white peer-checked:border-brand-600 peer-checked:shadow-lg peer-checked:shadow-brand-500/20">
                                    {{ role | capitalize }}
                                </div>
                            </label>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 2: Metrics -->
            <div class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm animate-in fade-in slide-in-from-bottom-4 duration-700 delay-300">
                <h2 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-brand-100 text-brand-600 text-sm font-black">2</span>
                    Scale & Reach
                </h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div>
                        <label for="averageAttendeeCount" class="block text-sm font-bold text-slate-700 mb-2 uppercase tracking-wider">Avg. Attendee Count</label>
                        <input type="number" id="averageAttendeeCount" name="averageAttendeeCount" min="0" placeholder="e.g. 100"
                            class="w-full px-4 py-3 rounded-2xl bg-white border border-slate-200 text-slate-800 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all outline-none">
                    </div>
                    <div>
                        <label for="averageEventCountExcepected" class="block text-sm font-bold text-slate-700 mb-2 uppercase tracking-wider">Expected Events (Yearly)</label>
                        <input type="number" id="averageEventCountExcepected" name="averageEventCountExcepected" min="0" placeholder="e.g. 12"
                            class="w-full px-4 py-3 rounded-2xl bg-white border border-slate-200 text-slate-800 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all outline-none">
                    </div>
                </div>
            </div>

            <!-- Section 3: Tools & Objectives -->
            <div class="bg-white border border-slate-200 rounded-2xl p-8 shadow-sm animate-in fade-in slide-in-from-bottom-4 duration-700 delay-450">
                <h2 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-brand-100 text-brand-600 text-sm font-black">3</span>
                    Tools & Objectives
                </h2>

                <div class="space-y-8">
                    <!-- Tool Stack (Interactive Tags) -->
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2 uppercase tracking-wider">Existing Tool Stack</label>
                        <div class="mt-2">
                            <div id="tag-container" class="flex flex-wrap gap-2 mb-3">
                                <!-- Tags will be injected here -->
                            </div>
                            <div class="relative">
                                <input type="text" id="tool-input" placeholder="Add a tool (e.g. Zoom, Slack, Jira) and press Enter"
                                    class="w-full px-4 py-3 rounded-2xl bg-white border border-slate-200 text-slate-800 focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all outline-none">
                                <button type="button" id="add-tool-btn" class="absolute right-2 top-2 px-4 py-1.5 bg-brand-600 text-white rounded-lg text-sm font-bold hover:bg-brand-700 transition-colors">Add</button>
                            </div>
                            
                            <!-- Suggested Tools from Backend -->
                            <div class="mt-4">
                                <p class="text-xs font-bold text-slate-400 uppercase mb-2">Suggested Tools</p>
                                <div class="flex flex-wrap gap-2">
                                    {% for tool in tools %}
                                    <button type="button" onclick="quickAddTool('{{ tool }}')" 
                                        class="px-3 py-1 bg-slate-100 hover:bg-brand-100 text-slate-600 hover:text-brand-700 rounded-md text-xs font-bold transition-colors">
                                        + {{ tool }}
                                    </button>
                                    {% endfor %}
                                </div>
                            </div>

                            <input type="hidden" name="toolStack" id="toolStackHidden">
                        </div>
                    </div>

                    <!-- Main Objective -->
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-4 uppercase tracking-wider">What is your main objective?</label>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            {% for objective in objectives %}
                            <label class="relative group cursor-pointer">
                                <input type="checkbox" name="mainObjectiveOfUser" value="{{ objective }}" class="peer sr-only">
                                <div class="h-full p-4 rounded-2xl border border-slate-200 bg-white text-center transition-all group-hover:border-brand-300 peer-checked:bg-brand-600/5 peer-checked:border-brand-600 peer-checked:ring-1 peer-checked:ring-brand-600">
                                    <span class="block text-slate-800 font-bold mb-1">{{ objective }}</span>
                                    <span class="block text-xs text-slate-500">Select to focus on {{ objective.lower() }} goals.</span>
                                </div>
                            </label>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="flex justify-end pt-6 animate-in fade-in slide-in-from-bottom-4 duration-700 delay-600">
                <button type="submit" class="px-10 py-4 bg-brand-600 hover:bg-brand-500 text-white font-black rounded-2xl shadow-premium shadow-brand-500/20 hover:shadow-brand-500/40 transition-all hover:-translate-y-1 active:translate-y-0 text-lg">
                    Save Profile & Continue
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    // Tool Stack Tag Logic
    const toolInput = document.getElementById('tool-input');
    const tagContainer = document.getElementById('tag-container');
    const toolStackHidden = document.getElementById('toolStackHidden');
    const addBtn = document.getElementById('add-tool-btn');
    
    let tools = [];

    function updateHiddenInput() {
        toolStackHidden.value = JSON.stringify(tools);
    }

    function removeTool(tool) {
        tools = tools.filter(t => t !== tool);
        renderTags();
        updateHiddenInput();
    }

    function renderTags() {
        tagContainer.innerHTML = '';
        tools.forEach(tool => {
            const tag = document.createElement('div');
            tag.className = 'flex items-center gap-2 px-3 py-1.5 bg-brand-100 text-brand-800 font-semibold rounded-lg text-sm font-bold border border-brand-100 animate-in zoom-in duration-200';
            tag.innerHTML = `
                ${tool}
                <button type="button" class="hover:text-brand-950 transition-colors" onclick="removeTool('${tool.replace(/'/g, "\\'")}')">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            `;
            tagContainer.appendChild(tag);
        });
    }

    function addTool() {
        const value = toolInput.value.trim();
        if (value && !tools.includes(value)) {
            tools.push(value);
            renderTags();
            updateHiddenInput();
            toolInput.value = '';
        }
    }

    window.quickAddTool = function(tool) {
        if (!tools.includes(tool)) {
            tools.push(tool);
            renderTags();
            updateHiddenInput();
        }
    };

    toolInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
            e.preventDefault();
            addTool();
        }
    });

    addBtn.addEventListener('click', addTool);

    // Form Submission Logic
    const profileForm = document.getElementById('profileForm');
    if (profileForm) {
        profileForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            // Gather all data
            const industries = Array.from(document.querySelectorAll('input[name="industry"]:checked')).map(cb => cb.value);
            const roles = Array.from(document.querySelectorAll('input[name="role"]:checked')).map(cb => cb.value);
            const objectives = Array.from(document.querySelectorAll('input[name="mainObjectiveOfUser"]:checked')).map(cb => cb.value);
            
            const formData = {
                industry: industries,
                role: roles,
                averageAttendeeCount: parseInt(document.getElementById('averageAttendeeCount').value) || 0,
                averageEventCountExcepected: parseInt(document.getElementById('averageEventCountExcepected').value) || 0,
                toolStack: JSON.parse(toolStackHidden.value || "[]"),
                mainObjectiveOfUser: objectives
            };

            // Basic validation
            if (industries.length === 0 || roles.length === 0 || objectives.length === 0) {
                alert('Please select at least one industry, role, and objective.');
                return;
            }

            try {
                // Show loading state
                const submitBtn = profileForm.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerText;
                submitBtn.innerText = 'Saving...';
                submitBtn.disabled = true;

                const response = await fetch("{{ url_for('auth_login.setup_profile') }}", {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(formData)
                });
                
                const contentType = response.headers.get("content-type");
                if (contentType && contentType.indexOf("application/json") !== -1) {
                    const result = await response.json();
                    if (result.status === 'success' && result.redirect) {
                        window.location.href = result.redirect;
                    } else {
                        alert('Error: ' + (result.message || 'Failed to save profile.'));
                        submitBtn.innerText = originalText;
                        submitBtn.disabled = false;
                    }
                } else {
                    // It's likely an HTML error page
                    const errorText = await response.text();
                    console.error('Server returned non-JSON response:', errorText);
                    alert('Server error: The server returned an unexpected response format. Please check the logs.');
                    submitBtn.innerText = originalText;
                    submitBtn.disabled = false;
                }
            } catch (error) {
                console.error('Submission error:', error);
                alert('Connection error: Could not connect to the server. Please check your internet connection.');
                const submitBtn = profileForm.querySelector('button[type="submit"]');
                if (submitBtn) {
                    submitBtn.innerText = 'Save Profile & Continue';
                    submitBtn.disabled = false;
                }
            }
        });
    }
</script>

