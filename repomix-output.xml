                <div data-org-id="{{ org.id }}" data-org-name="{{ org.orgName }}" data-org-industry="{{ org.industry }}"
                    onclick="openEventsModal(this.dataset.orgId, this.dataset.orgName)"
                    class="org-card bg-white border border-slate-200 rounded-2xl p-6 hover:border-brand-500 hover:shadow-premium hover:shadow-premium-hover cursor-pointer transition-all duration-300 flex flex-col gap-4 group relative overflow-hidden shadow-sm">

                    <div
                        class="absolute top-0 right-0 p-2 text-[10px] font-bold bg-slate-100 rounded-bl-lg text-slate-500 uppercase tracking-tighter z-10">
                        {{ org.industry }}
                    </div>

                    <div class="flex justify-between items-start mt-2 gap-4">
                        <div class="flex-1 min-w-0">
                            <h3 class="text-lg font-bold text-slate-800 group-hover:text-brand-600 transition-colors truncate"
                                title="{{ org.orgName }}">
                                {{ org.orgName }}
                            </h3>
                            <div class="text-slate-500 text-sm flex items-center gap-2 mt-1">
                                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                                    </path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                                <span class="truncate">{{ org.address }}</span>
                            </div>
                        </div>

                        <div class="relative z-30 flex-shrink-0">
                            <button onclick="event.stopPropagation(); toggleOrgMenu('{{ org.id }}')"
                                class="p-1.5 text-slate-400 hover:text-brand-600 hover:bg-slate-100 rounded-md transition-all">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z">
                                    </path>
                                </svg>
                            </button>
                            <div id="menu-{{ org.id }}"
                                class="hidden absolute right-0 top-full mt-1 w-32 bg-white border border-slate-200 rounded-lg shadow-lg overflow-hidden py-1">
                                <button
                                    onclick="event.stopPropagation(); showUpdateOrgModal('{{ org.id }}', '{{ org.orgName | escape }}', '{{ org.address | escape }}', '{{ org.industry | escape }}', '{{ org.userRole | escape }}')"
                                    class="w-full px-4 py-2 text-left text-sm text-slate-700 hover:bg-white flex items-center gap-2 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                        </path>
                                    </svg>
                                    Update
                                </button>
                                <button
                                    onclick="event.stopPropagation(); showConfirmDeleteOrg('{{ org.id }}', '{{ org.orgName | escape }}')"
                                    class="w-full px-4 py-2 text-left text-sm text-red-600 hover:bg-red-50 flex items-center gap-2 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                        </path>
                                    </svg>
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="mt-auto pt-4 border-t border-slate-100 flex justify-between items-center text-xs">
                        <span class="px-2 py-1 bg-brand-100 text-brand-800 font-semibold rounded font-bold uppercase tracking-wider">{{
                            org.userRole }}</span>
                        <span
                            class="text-brand-600 font-semibold group-hover:translate-x-1 transition-transform flex items-center gap-1">View
                            Events &rarr;</span>
                    </div>
                </div>
                {% endfor %}
            </div>

            <div id="noResults"
                class="hidden flex flex-col items-center justify-center py-20 bg-white border border-dashed border-slate-200 rounded-2xl">
                <svg class="w-16 h-16 text-slate-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <p class="text-slate-500 text-lg font-medium">No organizations found matching your search.</p>
                <button onclick="clearSearch()" class="mt-4 text-brand-600 font-bold hover:underline">Clear
                    search</button>
            </div>

            <!-- Action buttons (removed and moved to header/top area) -->

            <!-- Modal for Events -->
            <div id="eventsModal"
                class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
                <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-lg shadow-premium scale-95 opacity-0 transition-all duration-200"
                    id="eventsModalContent">
                    <div class="p-6 border-b border-slate-200 flex justify-between items-center">
                        <h3 class="text-xl font-bold text-slate-800" id="modalOrgName">Events</h3>
                        <button onclick="closeEventsModal()"
                            class="text-slate-400 hover:text-slate-600 p-1 rounded-md hover:bg-slate-100 transition-colors">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                    <div class="p-6 space-y-3 max-h-[60vh] overflow-y-auto" id="eventsList">
                        <!-- Events injected via JS -->
                        <div class="flex items-center justify-center py-8 text-slate-500">
                            <svg class="animate-spin h-6 w-6 mr-3 text-brand-500" viewBox="0 0 24 24" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                    stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor"
                                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                                </path>
                            </svg>
                            Loading events...
                        </div>
                    </div>
                </div>
            </div>
            <script>
                function filterOrganizations() {
                    const query = document.getElementById('orgSearchInput').value.toLowerCase();
                    const grid = document.getElementById('orgGrid');
                    const cards = grid.getElementsByClassName('org-card');
                    const noResults = document.getElementById('noResults');
                    let hasResults = false;

                    Array.from(cards).forEach(card => {
                        const name = card.getAttribute('data-org-name').toLowerCase();
                        const industry = card.getAttribute('data-org-industry').toLowerCase();

                        if (name.includes(query) || industry.includes(query)) {
                            card.classList.remove('hidden');
                            hasResults = true;
                        } else {
                            card.classList.add('hidden');
                        }
                    });

                    if (hasResults) {
                        grid.classList.remove('hidden');
                        grid.classList.add('grid');
                        noResults.classList.add('hidden');
                    } else {
                        grid.classList.remove('grid');
                        grid.classList.add('hidden');
                        noResults.classList.remove('hidden');
                    }
                }

                function clearSearch() {
                    document.getElementById('orgSearchInput').value = '';
                    filterOrganizations();
                }

                function openCreateOrgModal() {
                    const modal = document.getElementById('createOrgModal');
                    const modalContent = document.getElementById('createOrgModalContent');
                    modal.classList.remove('hidden');
                    setTimeout(() => {
                        modalContent.classList.remove('scale-95', 'opacity-0');
                        modalContent.classList.add('scale-100', 'opacity-100');
                    }, 10);
                }

                function closeCreateOrgModal() {
                    const modal = document.getElementById('createOrgModal');
                    const modalContent = document.getElementById('createOrgModalContent');
                    modalContent.classList.add('scale-95', 'opacity-0');
                    modalContent.classList.remove('scale-100', 'opacity-100');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                    }, 200);
                }

                function saveOrg() {
                    const orgName = document.getElementById('newOrgName').value;
                    const address = document.getElementById('newOrgAddress').value;
                    const industry = document.getElementById('newOrgIndustry').value;
                    const userRole = document.getElementById('newOrgRole').value;

                    if (!orgName) {
                        alert("Please enter an organization name");
                        return;
                    }

                    fetch('/main-dashboard/create-org', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            orgName: orgName,
                            address: address,
                            industry: industry,
                            userRole: userRole
                        })
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.message === "Success") {
                                window.location.reload();
                            } else {
                                alert("Failed to create org: " + (data.data || "Unknown error"));
                            }
                        })
                        .catch(err => {
                            alert("An error occurred. Please try again.");
                            console.error(err);
                        });
                }

                function openEventsModal(orgId, orgName) {
                    const modal = document.getElementById('eventsModal');
                    const modalContent = document.getElementById('eventsModalContent');
                    document.getElementById('modalOrgName').innerText = orgName + ' Events';

                    modal.classList.remove('hidden');
                    setTimeout(() => {
                        modalContent.classList.remove('scale-95', 'opacity-0');
                        modalContent.classList.add('scale-100', 'opacity-100');
                    }, 10);

                    fetch(`/main-dashboard/get-org-projects/${orgId}`)
                        .then(res => res.json())
                        .then(data => {
                            const list = document.getElementById('eventsList');
                            list.innerHTML = '';
                            if (data.length === 0) {
                                list.innerHTML = '<p class="text-gray-500 text-center py-8">No events found.</p>';
                            } else {
                                data.forEach(event => {
                                    list.innerHTML += `
                                            <a href="/event-dashboard/${event.id}" target="_blank" class="block p-4 bg-white border border-slate-100 rounded-lg hover:border-brand-500 transition-all group">
                                                <div class="flex justify-between items-start">
                                                    <div>
                                                        <h4 class="font-bold text-slate-800 text-md group-hover:text-brand-600 transition-colors">${event.name}</h4>
                                                        <div class="text-xs border-t border-slate-200 mt-2 pt-2 flex flex-wrap items-center gap-3">
                                                            <span class="text-slate-500 flex items-center gap-1">${event.date}</span>
                                                            <span class="px-1.5 py-0.5 bg-slate-200 text-slate-600 rounded text-[10px] font-bold uppercase">${event.status}</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        `;
                                });
                            }
                        });
                }

                function closeEventsModal() {
                    const modal = document.getElementById('eventsModal');
                    const modalContent = document.getElementById('eventsModalContent');
                    modalContent.classList.add('scale-95', 'opacity-0');
                    modalContent.classList.remove('scale-100', 'opacity-100');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                    }, 200);
                }

                let activeOrgMenu = null;

                function toggleOrgMenu(orgId) {
                    const menu = document.getElementById(`menu-${orgId}`);
                    if (activeOrgMenu && activeOrgMenu !== menu) {
                        activeOrgMenu.classList.add('hidden');
                    }
                    menu.classList.toggle('hidden');
                    activeOrgMenu = menu.classList.contains('hidden') ? null : menu;
                }

                // Close menus when clicking anywhere
                document.addEventListener('click', () => {
                    if (activeOrgMenu) {
                        activeOrgMenu.classList.add('hidden');
                        activeOrgMenu = null;
                    }
                });

                function showUpdateOrgModal(orgId, orgName, address, industry, role) {
                    document.getElementById('updateOrgId').value = orgId;
                    document.getElementById('updateOrgName').value = orgName;
                    document.getElementById('updateOrgAddress').value = address;
                    document.getElementById('updateOrgIndustry').value = industry;
                    document.getElementById('updateOrgRole').value = role;

                    const modal = document.getElementById('updateOrgModal');
                    const modalContent = document.getElementById('updateOrgModalContent');
                    modal.classList.remove('hidden');
                    setTimeout(() => {
                        modalContent.classList.remove('scale-95', 'opacity-0');
                        modalContent.classList.add('scale-100', 'opacity-100');
                    }, 10);
                }

                function closeUpdateOrgModal() {
                    const modal = document.getElementById('updateOrgModal');
                    const modalContent = document.getElementById('updateOrgModalContent');
                    modalContent.classList.add('scale-95', 'opacity-0');
                    modalContent.classList.remove('scale-100', 'opacity-100');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                    }, 200);
                }

                function saveUpdatedOrg() {
                    const orgId = document.getElementById('updateOrgId').value;
                    const orgName = document.getElementById('updateOrgName').value;
                    const address = document.getElementById('updateOrgAddress').value;
                    const industry = document.getElementById('updateOrgIndustry').value;
                    const userRole = document.getElementById('updateOrgRole').value;

                    if (!orgName) {
                        alert("Please enter an organization name");
                        return;
                    }

                    fetch(`/main-dashboard/update-org/${orgId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            orgName: orgName,
                            address: address,
                            industry: industry,
                            userRole: userRole
                        })
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.message === "Success") {
                                window.location.reload();
                            } else {
                                alert("Failed to update org: " + (data.data || "Unknown error"));
                            }
                        })
                        .catch(err => {
                            alert("An error occurred. Please try again.");
                            console.error(err);
                        });
                }

                function showConfirmDeleteOrg(orgId, orgName) {
                    openConfirmModal(
                        'Delete Organization',
                        `Are you sure you want to delete "${orgName}"? This will also delete all associated projects, posts, and participants. This action cannot be undone.`,
                        'Delete',
                        () => removeOrg(orgId),
                        'danger'
                    );
                }

                function removeOrg(orgId) {
                    fetch(`/main-dashboard/remove-org/${orgId}`, {
                        method: 'DELETE'
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.message === "success") {
                                // Find and remove the card from UI
                                const card = document.querySelector(`[data-org-id="${orgId}"]`);
                                if (card) {
                                    card.style.opacity = '0';
                                    card.style.transform = 'scale(0.9)';
                                    setTimeout(() => card.remove(), 200);
                                } else {
                                    window.location.reload();
                                }
                            } else {
                                alert("Failed to remove organization: " + (data.data || "Unknown error"));
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            alert("An error occurred while deleting the organization.");
                        });
                }
            </script>

            <!-- Modal for Create Org -->
            <div id="createOrgModal"
                class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
                <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-lg shadow-premium scale-95 opacity-0 transition-all duration-200"
                    id="createOrgModalContent">
                    <div class="p-6 border-b border-slate-200 flex justify-between items-center">
                        <h3 class="text-xl font-bold text-slate-800">Create Organization</h3>
                        <button onclick="closeCreateOrgModal()"
                            class="text-slate-400 hover:text-slate-600 p-1 rounded-md hover:bg-slate-100 transition-colors">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                    <div class="p-6 space-y-4">
                        <div>
                            <label
                                class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Organization
                                Name</label>
                            <input id="newOrgName" type="text" placeholder="e.g. Acme Corp"
                                class="w-full bg-white border border-slate-200 rounded-md px-4 py-2 text-slate-800 focus:ring-2 focus:ring-brand-500 outline-none transition-all">
                        </div>
                        <div>
                            <label
                                class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Address</label>
                            <input id="newOrgAddress" type="text" placeholder="e.g. 123 Main St"
                                class="w-full bg-white border border-slate-200 rounded-md px-4 py-2 text-slate-800 focus:ring-2 focus:ring-brand-500 outline-none transition-all">
                        </div>
                        <div>
                            <label
                                class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Industry</label>
                            <select id="newOrgIndustry"
                                class="w-full bg-white border border-slate-200 rounded-md px-4 py-2 text-slate-800 focus:ring-2 focus:ring-brand-500 outline-none transition-all">
                                {% for industry in industries %}
                                <option value="{{ industry }}">{{ industry }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Your
                                Role</label>
                            <select id="newOrgRole"
                                class="w-full bg-white border border-slate-200 rounded-md px-4 py-2 text-slate-800 focus:ring-2 focus:ring-brand-500 outline-none transition-all">
                                {% for role in roles %}
                                <option value="{{ role }}">{{ role }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <button onclick="saveOrg()"
                            class="w-full bg-brand-500 hover:bg-brand-600 text-white font-bold py-2.5 rounded-md transition-all shadow-sm">Save
                            Organization</button>
                    </div>
                </div>
            </div>

            <!-- Modal for Update Org -->
            <div id="updateOrgModal"
                class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
                <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-lg shadow-premium scale-95 opacity-0 transition-all duration-200"
                    id="updateOrgModalContent">
                    <div class="p-6 border-b border-slate-200 flex justify-between items-center">
                        <h3 class="text-xl font-bold text-slate-800">Update Organization</h3>
                        <button onclick="closeUpdateOrgModal()"
                            class="text-slate-400 hover:text-slate-600 p-1 rounded-md hover:bg-slate-100 transition-colors">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                    <div class="p-6 space-y-4">
                        <input type="hidden" id="updateOrgId">
                        <div>
                            <label
                                class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Organization
                                Name</label>
                            <input id="updateOrgName" type="text" placeholder="e.g. Acme Corp"
                                class="w-full bg-white border border-slate-200 rounded-md px-4 py-2 text-slate-800 focus:ring-2 focus:ring-brand-500 outline-none transition-all">
                        </div>
                        <div>
                            <label
                                class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Address</label>
                            <input id="updateOrgAddress" type="text" placeholder="e.g. 123 Main St"
                                class="w-full bg-white border border-slate-200 rounded-md px-4 py-2 text-slate-800 focus:ring-2 focus:ring-brand-500 outline-none transition-all">
                        </div>
                        <div>
                            <label
                                class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Industry</label>
                            <select id="updateOrgIndustry"
                                class="w-full bg-white border border-slate-200 rounded-md px-4 py-2 text-slate-800 focus:ring-2 focus:ring-brand-500 outline-none transition-all">
                                {% for industry in industries %}
                                <option value="{{ industry }}">{{ industry }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Your
                                Role</label>
                            <select id="updateOrgRole"
                                class="w-full bg-white border border-slate-200 rounded-md px-4 py-2 text-slate-800 focus:ring-2 focus:ring-brand-500 outline-none transition-all">
                                {% for role in roles %}
                                <option value="{{ role }}">{{ role }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <button onclick="saveUpdatedOrg()"
                            class="w-full bg-brand-500 hover:bg-brand-600 text-white font-bold py-2.5 rounded-md transition-all shadow-sm">Update
                            Organization</button>
                    </div>
                </div>
            </div>
            {% elif active_tab == 'collabs' %}
            <div class="space-y-6">
                <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-4">
                        <div class="p-3 bg-brand-50 rounded-2xl">
                            <svg class="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-2xl font-bold text-slate-800 tracking-tight">Collaboration Invitations</h2>
                            <p class="text-slate-500 text-sm">Manage projects you have been invited to collaborate on.</p>
                        </div>
                    </div>
                </div>

                <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden min-h-[400px] flex flex-col">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-white border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-widest">
                                    <th class="px-6 py-4">Project & Org</th>
                                    <th class="px-6 py-4">Owner</th>
                                    <th class="px-6 py-4">Role</th>
                                    <th class="px-6 py-4">Status</th>
                                    <th class="px-6 py-4 text-right">Action</th>
                                </tr>
                            </thead>
                            <tbody id="collabsTableBody">
                                <!-- Data injected via JS -->
                                <tr>
                                    <td colspan="5" class="px-6 py-20 text-center">
                                        <div class="flex flex-col items-center gap-3">
                                            <svg class="animate-spin h-8 w-8 text-brand-500" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                            </svg>
                                            <span class="text-slate-500 font-medium">Loading invitations...</span>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    if ("{{ active_tab }}" === "collabs") {
                        loadCollabs();
                    }
                });

                async function loadCollabs() {
                    const tbody = document.getElementById('collabsTableBody');
                    try {
                        const response = await fetch('/main-dashboard/get-collabs');
                        const result = await response.json();

                        if (result.message === "Success") {
                            const data = result.data;
                            if (data.length === 0) {
                                tbody.innerHTML = `
                                    <tr>
                                        <td colspan="5" class="px-6 py-20 text-center text-slate-400">
                                            <div class="flex flex-col items-center gap-2">
                                                <svg class="w-12 h-12 text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                                                </svg>
                                                <p class="font-medium text-lg">No invitations found</p>
                                                <p class="text-sm">You haven't been invited to any projects yet.</p>
                                            </div>
                                        </td>
                                    </tr>`;
                                return;
                            }

                            tbody.innerHTML = data.map(col => `
                                <tr class="border-b border-slate-100 hover:bg-white/50 transition-colors group">
                                    <td class="px-6 py-4">
                                        <div class="flex flex-col min-w-0">
                                            <span class="font-bold text-slate-800 truncate" title="${col.projectName}">${col.projectName}</span>
                                            <span class="text-xs text-slate-500 flex items-center gap-1">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                                                ${col.orgname}
                                            </span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex items-center gap-2">
                                            <div class="w-7 h-7 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center text-[10px] font-bold">
                                                ${col.ownerName.charAt(0)}
                                            </div>
