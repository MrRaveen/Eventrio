            class="flex flex-col items-center {% if active_tab == 'settings' %}text-brand-600 font-bold{% else %}text-slate-400 hover:text-slate-600{% endif %}">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z">
                </path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z">
                </path>
            </svg>
            <span class="text-[10px] mt-1">Settings</span>
        </a>
    </div>

</div>
{% endblock %}
{% block scripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// Dashboard Event List Logic
    let DASHBOARD_EVENTS = [];

    function renderDashboardEventsLabel(status) {
        if (status === 'LIVE') return 'bg-emerald-50 text-emerald-600';
        if (status === 'COMPLETED') return 'bg-slate-100 text-slate-500';
        return 'bg-brand-50 text-brand-600'; // PLANNING
    }

    async function loadDashboardEvents() {
        const container = document.getElementById('mainEventList');
        if (!container) return;

        try {
            const res = await fetch('/main-dashboard/get-list-events');
            const result = await res.json();
            
            if (result.message === 'Success') {
                DASHBOARD_EVENTS = result.data;
                renderDashboardEvents(DASHBOARD_EVENTS);
            } else {
                console.error("API Error:", result.data);
                container.innerHTML = `<div class="p-4 text-amber-500 text-center font-medium">Error: ${result.message}</div>`;
            }
        } catch (err) {
            console.error("Error loading events:", err);
            container.innerHTML = '<div class="p-4 text-red-500 text-center">Failed to load events.</div>';
        }
    }

    function renderDashboardEvents(events) {
        const container = document.getElementById('mainEventList');
        if (!container) return;

        if (events.length === 0) {
            container.innerHTML = '<div class="p-8 text-slate-400 text-center font-medium">No events found.</div>';
            return;
        }

        container.innerHTML = events.map(event => {
            const dateStr = new Date(event.startDate).toLocaleDateString('en-US', {
                month: 'short', day: '2-digit', year: 'numeric'
            });
            const location = event.organizationName || 'General';
            
            return `
                <div onclick="window.location.href='/event-dashboard/${event.eventDocID}'"
                    class="bg-white p-4 border border-slate-200 rounded-2xl hover:border-brand-500 hover:shadow-sm cursor-pointer transition-all group">
                    <div class="flex justify-between items-start mb-2">
                        <h4 class="font-bold text-slate-800 group-hover:text-brand-600">${event.eventName}</h4>
                        <span class="px-2 py-0.5 ${renderDashboardEventsLabel(event.eventStatus)} rounded text-[10px] font-bold uppercase">
                            ${event.eventStatus}
                        </span>
                    </div>
                    <p class="text-xs text-slate-500 mb-2">${location} • ${dateStr}</p>
                </div>
            `;
        }).join('');
    }

    document.addEventListener('DOMContentLoaded', function () {
        // Init search
        const searchInput = document.getElementById('eventSearchInput');
        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                const term = e.target.value.toLowerCase();
                const filtered = DASHBOARD_EVENTS.filter(ev => 
                    ev.eventName.toLowerCase().includes(term) || 
                    (ev.organizationName && ev.organizationName.toLowerCase().includes(term))
                );
                renderDashboardEvents(filtered);
            });
        }

        // Auto-load if tab is engagement
        {% if active_tab == 'engagement' %}
        loadDashboardEvents();
        {% endif %}

        if (document.getElementById('engagementChart')) {
            const ctx = document.getElementById('engagementChart').getContext('2d');

            // Dummy data for ticket sales
            const labels = ['Week 1', 'Week 2', 'Week 3', 'Week 4', 'Week 5', 'Week 6', 'Week 7', 'Week 8'];
            const data = [12, 19, 45, 82, 120, 195, 280, 358];

            new Chart(ctx, {
                type: 'bar', // Or 'line' or 'pie', etc.
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Tickets Purchased',
                        data: data,
                        backgroundColor: '#6d28d9', // brand.600
                        borderColor: '#4c1d95', // brand.900
                        borderWidth: 0,
                        borderRadius: 6,
                        hoverBackgroundColor: '#4c1d95'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            backgroundColor: '#1e293b',
                            titleFont: { family: 'Inter', size: 13 },
                            bodyFont: { family: 'Inter', size: 13 },
                            padding: 12,
                            cornerRadius: 8,
                            displayColors: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: '#f1f5f9',
                                drawBorder: false
                            },
                            ticks: {
                                color: '#64748b',
                                font: { family: 'Inter', size: 11 },
                                padding: 8
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                color: '#64748b',
                                font: { family: 'Inter', size: 11 },
                                padding: 8
                            }
                        }
                    }
                }
            });
        }
    });
</script>
{% endblock %}
</file>

