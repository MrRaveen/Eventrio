                    <div>
                        <h2 class="text-2xl font-bold text-slate-800 leading-tight">
                            [[${user != null and user.givenName != null ? user.givenName + ' ' + user.familyName : (user != null and user.displayName != null ? user.displayName : 'John Doe')}]]
                        </h2>
                        <p class="text-slate-500 font-medium">[[${user != null ? user.email : 'john.doe@example.com'}]]</p>
