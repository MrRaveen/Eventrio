                    d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v16a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z">
                </path>
            </svg>
            <span class="text-[10px] mt-1">Engagement</span>
        </a>
        <a href="{{ url_for('ui_endpoints.ai_planner') }}"
            class="flex flex-col items-center {% if active_tab == 'ai-planner' %}text-brand-600 font-bold{% else %}text-slate-400 hover:text-slate-600{% endif %}">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0012 18.75c-1.03 0-1.9-.4-2.593-1.003l-.548-.547z">
                </path>
            </svg>
            <span class="text-[10px] mt-1">AI Planner</span>
        </a>
        <a href="{{ url_for('ui_endpoints.dashboard', tab='orgs') }}"
            class="flex flex-col items-center {% if active_tab == 'orgs' or active_tab == 'Organizations' %}text-brand-600 font-bold{% else %}text-slate-400 hover:text-slate-600{% endif %}">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4">
