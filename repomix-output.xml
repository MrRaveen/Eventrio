    </main>

    <!-- Mobile Navigation Bar (Bottom) - visible only on small screens -->
    <div
        class="md:hidden fixed bottom-0 left-0 right-0 h-16 bg-white border-t border-slate-200 flex justify-around items-center z-50 transition-colors duration-200 shadow-[0_-2px_10px_rgba(0,0,0,0.05)]">
        <a th:href="@{/dashboard(tab=engagement)}"
            class="flex flex-col items-center" th:classappend="${(active_tab == 'engagement') ? 'text-brand-600 font-bold' : 'text-slate-400 hover:text-slate-600'}">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v16a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z">
                </path>
