package agent;

// The service definition
service AgentService {
  // Unary RPC: one request, one response
  rpc RunAgent (AgentRequest) returns (AgentResponse);
}

// The request message (what client sends)
message AgentRequest {
  string eventID = 1;
  string tempUserID = 2;
  string query = 3;
}

// The response message (what server returns)
message AgentResponse {
  string eventID = 1;
  string job_id = 2;
  bool is_complete = 3;
  optional string error = 4;
}
