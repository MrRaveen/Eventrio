    <script src="bundle.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const statusEl = document.getElementById('connection-status');
            const chatForm = document.getElementById('chat-form');
            const chatInput = document.getElementById('chat-input');
            const chatContainer = document.getElementById('chat-container');
            const sendBtn = document.getElementById('send-btn');

            // Modal Elements
            const meetingUrlBtn = document.getElementById('meeting-url-btn');
            const urlModal = document.getElementById('url-modal');
            const closeModal = document.getElementById('close-modal');
            const meetingUrlInput = document.getElementById('meeting-url-input');
            const copyUrlBtn = document.getElementById('copy-url-btn');

            // API Base URL (change this to your tunnel URL when deploying)
            const API_BASE_URL = 'https://sciences-breeds-shareware-infrastructure.trycloudflare.com';

            const TOKEN_ENDPOINT = `${API_BASE_URL}/ai/get-temp-ID`;
            const AI_ENDPOINT = `${API_BASE_URL}/ai/test-agent`;
            const SSE_ENDPOINT = `${API_BASE_URL}/ai/listen-participant`;

            let meetClient = null;
            let authToken = null;
            let sseSource = null;
            let meetingUrl = 'unknown';

            // ── Step 1: Initialize the Meet SDK ──────────────────────────────
            try {
                if (window.eventrioChat && window.eventrioChat.initializeMainStage) {
                    meetClient = await window.eventrioChat.initializeMainStage();
                }
                console.log("Main stage bound successfully.");
                if (meetClient) {
                    meetingUrlBtn.style.display = 'inline-flex';
                    // Pre-fetch meeting URL once so we have it ready
                    try {
                        const meetingInfo = await meetClient.getMeetingInfo();
                        const meetingCode = meetingInfo.meetingCode;
                        meetingUrl = `https://meet.google.com/${meetingCode}`;
                        console.log("Meeting URL cached:", meetingUrl);
                    } catch (e) {
                        console.warn("Could not pre-fetch meeting info:", e);
                    }
                }
            } catch (error) {
                console.error("Failed to initialize main stage:", error);
                statusEl.textContent = "SDK Failed";
                statusEl.classList.add('error');
            }

            // ── Step 2: Obtain a temp JWT token ──────────────────────────────
            async function getAuthToken() {
                try {
                    const res = await fetch(TOKEN_ENDPOINT, { method: 'GET' });
                    if (!res.ok) throw new Error(`Token fetch failed: ${res.status}`);
                    const data = await res.json();
                    authToken = data.token;
                    console.log("Auth token obtained.");
                    return authToken;
                } catch (e) {
                    console.error("Failed to get auth token:", e);
                    statusEl.textContent = "Auth Failed";
                    statusEl.classList.add('error');
                    return null;
                }
            }

            // ── Step 3: Open SSE subscription BEFORE asking any question ─────
            function openSSEStream(token, currentMeetingUrl) {
                if (sseSource) {
                    sseSource.close();
                }
                const sseUrl = `${SSE_ENDPOINT}?token=${encodeURIComponent(token)}&meetingURL=${encodeURIComponent(currentMeetingUrl)}`;
                sseSource = new EventSource(sseUrl);

                sseSource.onopen = () => {
                    console.log("[SSE] Connection opened.");
                    statusEl.textContent = "Connected";
                    statusEl.classList.remove('error');
                };

                sseSource.onmessage = (event) => {
                    try {
                        const payload = JSON.parse(event.data);
                        console.log("[SSE] Message received:", payload);
                        removeLoading();
                        if (payload.res_text) {
                            addMessage(payload.res_text, 'bot');
                        } else if (payload.error) {
                            addMessage(`Error: ${payload.res_text || 'Unknown error'}`, 'bot');
                        }
                        // Re-enable input after we receive the response
                        chatInput.disabled = false;
                        sendBtn.disabled = false;
                        chatInput.focus();
                    } catch (e) {
                        console.error("[SSE] Parse error:", e);
                    }
                };

                sseSource.onerror = (err) => {
                    console.error("[SSE] Error:", err);
                    statusEl.textContent = "Stream Error";
                    statusEl.classList.add('error');
                };
            }

            // ── Init: Get token and open SSE ──────────────────────────────────
            statusEl.textContent = "Connecting...";
            const token = await getAuthToken();
            if (token && meetingUrl !== 'unknown') {
                openSSEStream(token, meetingUrl);
            } else if (token) {
                // SSE will be opened after meetingUrl is resolved on first submit
                statusEl.textContent = "Ready";
                statusEl.classList.remove('error');
            }

            // ── Modal Event Listeners ─────────────────────────────────────────
            if (meetingUrlBtn) {
                meetingUrlBtn.addEventListener('click', async () => {
                    if (meetClient) {
                        try {
                            const meetingInfo = await meetClient.getMeetingInfo();
                            const meetingCode = meetingInfo.meetingCode;
                            const url = `https://meet.google.com/${meetingCode}`;
                            meetingUrlInput.value = url;
                            urlModal.classList.add('show');
                        } catch (error) {
                            console.error("Failed to get meeting info:", error);
                            alert("Could not retrieve meeting info.");
                        }
                    }
                });
            }

            if (closeModal) {
                closeModal.addEventListener('click', () => {
                    urlModal.classList.remove('show');
                });
            }

            window.addEventListener('click', (e) => {
                if (e.target === urlModal) {
                    urlModal.classList.remove('show');
                }
            });

            if (copyUrlBtn) {
                copyUrlBtn.addEventListener('click', async () => {
                    try {
                        await navigator.clipboard.writeText(meetingUrlInput.value);
                        copyUrlBtn.textContent = "Copied!";
                        copyUrlBtn.style.background = "linear-gradient(135deg, #10b981, #059669)";
                        setTimeout(() => {
                            copyUrlBtn.textContent = "Copy";
                            copyUrlBtn.style.background = "";
                        }, 2000);
                    } catch (err) {
                        console.error("Failed to copy URL:", err);
                    }
                });
            }

            // ── UI Helpers ────────────────────────────────────────────────────
            function addMessage(text, sender) {
                const msgEl = document.createElement('div');
                msgEl.classList.add('message', sender);

                if (sender === 'bot') {
                    const paragraphs = text.split('\n\n').filter(p => p.trim() !== '');
                    paragraphs.forEach(pText => {
                        const p = document.createElement('p');
                        p.textContent = pText;
                        msgEl.appendChild(p);
                    });
                    if (paragraphs.length === 0) {
                        msgEl.textContent = text;
                    }
                } else {
                    msgEl.textContent = text;
                }

                chatContainer.appendChild(msgEl);
                chatContainer.scrollTop = chatContainer.scrollHeight;
                return msgEl;
            }

            function showLoading() {
                const loadingEl = document.createElement('div');
                loadingEl.classList.add('message', 'loading');
                loadingEl.id = 'loading-indicator';
                loadingEl.innerHTML = '<div class="typing-indicator"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>';
                chatContainer.appendChild(loadingEl);
                chatContainer.scrollTop = chatContainer.scrollHeight;
                return loadingEl;
            }

            function removeLoading() {
                const loadingEl = document.getElementById('loading-indicator');
                if (loadingEl) loadingEl.remove();
            }

            // ── Step 4: Submit question ───────────────────────────────────────
            chatForm.addEventListener('submit', async (e) => {
                e.preventDefault();

                const query = chatInput.value.trim();
                if (!query) return;

                // Ensure we have a token
                if (!authToken) {
                    addMessage("Authentication not ready. Please wait a moment.", 'bot');
                    return;
                }

                // Refresh meeting URL if needed
                if (meetClient && meetingUrl === 'unknown') {
                    try {
                        const meetingInfo = await meetClient.getMeetingInfo();
                        meetingUrl = `https://meet.google.com/${meetingInfo.meetingCode}`;
                        // Now open SSE since we finally have the URL
                        openSSEStream(authToken, meetingUrl);
                    } catch (error) {
                        console.error("Failed to fetch meeting info:", error);
                    }
                }

                addMessage(query, 'user');
                chatInput.value = '';
                chatInput.disabled = true;
                sendBtn.disabled = true;
                showLoading();

                try {
                    // POST the question — backend accepts and returns a job_id immediately
                    const response = await fetch(AI_ENDPOINT, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Authorization': `Bearer ${authToken}`
                        },
                        body: JSON.stringify({
                            query: query,
                            meetingURL: meetingUrl
                        })
                    });

                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }

                    const data = await response.json();

                    if (data.error) {
                        removeLoading();
                        addMessage(`Error: ${data.error}`, 'bot');
                        chatInput.disabled = false;
                        sendBtn.disabled = false;
                        chatInput.focus();
                    } else {
                        // Job accepted — response will arrive via SSE stream
                        console.log(`[Chat] Job accepted: ${data.job_id}. Waiting for SSE response...`);
                        // Loading stays visible until SSE message arrives
                    }
                } catch (error) {
                    console.error('Chat error:', error);
                    removeLoading();
                    addMessage("Sorry, I encountered an error communicating with the server.", 'bot');
                    chatInput.disabled = false;
                    sendBtn.disabled = false;
                    chatInput.focus();
                }
            });
        });
    </script>
</body>

</html>
