                            style="color:var(--text-primary);"
                        ></textarea>
                        <button onclick="sendGlobalChat()" class="ev-btn ev-btn-primary w-10 h-10 rounded-xl p-0 flex-shrink-0">
                            <svg class="w-5 h-5 text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"/></svg>
                        </button>
                    </div>
                </div>
                <p class="text-center mt-2 text-[10px] font-semibold uppercase tracking-widest" style="color:var(--text-muted);">Powered by Eventrio AI Engine</p>
            </div>
        </div>

    </main>
</div>

<!-- ═══ AI GENERATION LOADING OVERLAY ═══ -->
<div id="aiLoadingOverlay" style="display:none; position:fixed; inset:0; z-index:9999; background:var(--bg-body); transition:opacity 0.4s;">
    <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; gap:32px;">
        <!-- Animated spinner -->
        <div style="position:relative; width:80px; height:80px;">
            <div style="position:absolute; inset:0; border-radius:50%; border:3px solid var(--border);"></div>
            <div class="ai-spinner" style="position:absolute; inset:0; border-radius:50%; border:3px solid transparent; border-top-color:var(--brand-solid);"></div>
            <div style="position:absolute; inset:16px; border-radius:50%; background:var(--brand-bg); display:flex; align-items:center; justify-content:center;">
                <svg class="w-6 h-6" style="color:var(--brand-solid);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
        </div>
        <!-- Status text -->
        <div style="text-align:center;">
            <p id="aiLoadingStatus" style="font-size:18px; font-weight:700; color:var(--text-primary); margin:0 0 8px;">Initializing AI Engine...</p>
            <p style="font-size:13px; color:var(--text-muted); margin:0;">This may take a minute. Please don't close this page.</p>
        </div>
        <!-- Progress dots -->
        <div style="display:flex; gap:6px;">
            <div class="typing-dot"></div><div class="typing-dot"></div><div class="typing-dot"></div>
        </div>
    </div>
</div>

<style>
    @keyframes aiSpin { to { transform: rotate(360deg); } }
    .ai-spinner { animation: aiSpin 1s linear infinite; }
</style>

<script>
    // ─── Rotating AI status messages ───
    const AI_MESSAGES = [
        "🧠 Thinking about your event...",
        "📝 Extracting event details...",
        "🗓️ Planning the schedule...",
        "🎨 Creating the event poster...",
        "📄 Generating documentation...",
        "💬 Writing social media posts...",
        "📊 Building the agenda...",
        "⚡ Orchestrating services...",
        "🔗 Setting up Google integrations...",
        "✨ Almost there, finalizing everything..."
    ];
    let _msgInterval = null;

    function showLoadingOverlay() {
        const overlay = document.getElementById('aiLoadingOverlay');
        overlay.style.display = 'block';
        overlay.style.opacity = '1';
        let idx = 0;
        const statusEl = document.getElementById('aiLoadingStatus');
        statusEl.textContent = AI_MESSAGES[0];
        _msgInterval = setInterval(() => {
            idx = (idx + 1) % AI_MESSAGES.length;
            statusEl.style.opacity = '0';
            setTimeout(() => {
                statusEl.textContent = AI_MESSAGES[idx];
                statusEl.style.opacity = '1';
            }, 300);
        }, 3500);
    }

    function hideLoadingOverlay() {
        if (_msgInterval) { clearInterval(_msgInterval); _msgInterval = null; }
        const overlay = document.getElementById('aiLoadingOverlay');
        overlay.style.opacity = '0';
        setTimeout(() => { overlay.style.display = 'none'; }, 400);
    }

    // ─── SSE notification listener ───
    let _evtSource = null;

    function startSSEListener() {
        if (_evtSource) _evtSource.close();
        _evtSource = new EventSource('/notifications/listen');
        _evtSource.onmessage = function(event) {
            try {
                const payload = JSON.parse(event.data);
                hideLoadingOverlay();
                if (_evtSource) { _evtSource.close(); _evtSource = null; }

                const projectID = payload.projectID;
                appendMsg(`<div class="flex items-start gap-4 animate-fadeInUp"><div class="w-10 h-10 rounded-2xl flex items-center justify-center flex-shrink-0" style="background:#10b981;"><svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg></div><div class="chat-bubble-ai px-5 py-4 flex-1"><p class="text-sm font-bold mb-1" style="color:var(--text-primary);">✅ Event generated successfully!</p><p class="text-sm" style="color:var(--text-secondary);">Your AI-powered event is ready. Redirecting to your event dashboard...</p></div></div>`);

                setTimeout(() => {
                    if (projectID) {
                        window.location.href = `/event-dashboard/${projectID}`;
                    }
                }, 2000);
            } catch(e) { console.error('SSE parse error', e); }
        };
        _evtSource.onerror = function() {
            console.warn('SSE connection error, will auto-reconnect');
        };
    }

    // ─── Page init ───
    document.addEventListener('DOMContentLoaded', () => {
        const fbSelect = document.getElementById('chatFbPageSelect');
        if (fbSelect) {
            fetch('/main-dashboard/get-fb-pages')
                .then(res => { if (!res.ok) throw new Error(); return res.json(); })
                .then(data => {
                    fbSelect.innerHTML = '<option value="">No need to post</option>';
                    if (!data.error && Array.isArray(data) && data.length > 0) {
                        data.forEach(page => {
                            const opt = document.createElement('option');
                            opt.value = page.page_id;
                            opt.textContent = page.page_name;
                            fbSelect.appendChild(opt);
                        });
                    }
                })
                .catch(() => { fbSelect.innerHTML = '<option value="">No need to post</option>'; });
        }

        document.getElementById('aiLoadingStatus').style.transition = 'opacity 0.3s ease';
    });

    function handleKey(e) {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendGlobalChat(); }
    }

    function quickPrompt(text) {
        document.getElementById('globalChatInput').value = text;
        sendGlobalChat();
    }

    function appendMsg(html) {
        const win = document.getElementById('globalChatWindow');
        const inner = win.querySelector('.max-w-3xl');
        const el = document.createElement('div');
        el.innerHTML = html.trim();
        inner.appendChild(el.firstElementChild);
        win.scrollTop = win.scrollHeight;
    }

    function sendGlobalChat() {
        const input = document.getElementById('globalChatInput');
        const orgSelect = document.getElementById('chatOrgSelect');
        const text = input.value.trim();
        if (!text) return;
        if (!orgSelect || !orgSelect.value) {
            Swal.fire({ icon:'warning', title:'Select Organization', text:'Please select an organization before generating.', confirmButtonColor:'#6E50F7' });
            return;
        }

        appendMsg(`<div class="flex justify-end animate-fadeInUp"><div class="chat-bubble-user px-4 py-3 max-w-[80%] text-sm font-medium">${text.replace(/\n/g,'<br>')}</div></div>`);
        input.value = '';
        input.style.height = 'auto';

        const fbSelect = document.getElementById('chatFbPageSelect');
        const pageId = fbSelect && fbSelect.value ? fbSelect.value : null;

        // Show loading overlay and start SSE listener BEFORE the fetch
        showLoadingOverlay();
        startSSEListener();

        fetch('/ai/generate-event', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prompt: text, orgID: orgSelect.value, page_id: pageId })
        })
        .then(res => res.json())
        .then(data => {
            if (data.error) {
                hideLoadingOverlay();
                if (_evtSource) { _evtSource.close(); _evtSource = null; }
                appendMsg(`<div class="flex justify-center animate-fadeInUp"><div class="px-4 py-2 rounded-lg text-xs font-semibold" style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);color:#ef4444;">Error: ${data.error}</div></div>`);
            }
            // If success (202), keep waiting — SSE will handle the completion
        })
        .catch(() => {
            hideLoadingOverlay();
            if (_evtSource) { _evtSource.close(); _evtSource = null; }
            appendMsg(`<div class="flex justify-center animate-fadeInUp"><div class="px-4 py-2 rounded-lg text-xs font-semibold" style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.2);color:#ef4444;">Connection failed. Please try again.</div></div>`);
        });
    }

    document.getElementById('globalChatInput').addEventListener('input', function() {
        this.style.height = 'auto';
        this.style.height = this.scrollHeight + 'px';
    });
</script>

</section>
</body>
</html>
</file>

<file path="eventrio-springboot/eventrio-web-service/src/main/resources/templates/base.html">
<!DOCTYPE html>
<html lang="en" class="light" xmlns:th="http://www.thymeleaf.org" th:fragment="layout(content)">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eventrio — Professional Event Orchestration</title>
    <link rel="stylesheet" th:href="@{/css/app.css}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- ═══ THEME SYSTEM ═══ -->
    <script>
        // Apply saved theme instantly to prevent flash
        (function() {
            var t = localStorage.getItem('eventrio-theme') || 'light';
            document.documentElement.className = t;
        })();
    </script>

    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; margin: 0; }

        /* ════════════════════════════════════════════
           CSS CUSTOM PROPERTIES — LIGHT THEME (default)
           ════════════════════════════════════════════ */
        :root, html.light {
            --bg-body:        #F8F8FA;
            --bg-sidebar:     #FFFFFF;
            --bg-card:        #FFFFFF;
            --bg-surface:     #F3F3F6;
            --bg-input:       #F5F5F7;
            --bg-hover:       #EDEDF2;
            --bg-modal:       #FFFFFF;
            --bg-header:      rgba(255,255,255,0.85);

            --border:         #E5E5EA;
            --border-subtle:  #ECECF0;

            --text-primary:   #1A1A2E;
            --text-secondary: #6B6B80;
            --text-muted:     #9D9DB0;
            --text-inverse:   #FFFFFF;

            --brand-bg:       #F3F0FF;
            --brand-text:     #5538E8;
            --brand-border:   #E5DFFF;
            --brand-solid:    #6E50F7;
            --brand-solid-h:  #5538E8;

            --nav-active-bg:      #F3F0FF;
            --nav-active-text:    #5538E8;
            --nav-active-border:  #C9BFFF;
            --nav-text:           #6B6B80;
            --nav-hover-bg:       #F3F3F6;

            --shadow-sm:  0 1px 3px rgba(0,0,0,0.06);
            --shadow-md:  0 4px 16px rgba(0,0,0,0.08);
            --shadow-lg:  0 8px 32px rgba(0,0,0,0.1);
            --shadow-modal: 0 20px 60px rgba(0,0,0,0.15);

            --overlay:    rgba(0,0,0,0.4);
            color-scheme: light;
        }

        /* ════════════════════════════════════════════
           CSS CUSTOM PROPERTIES — DARK THEME
           ════════════════════════════════════════════ */
        html.dark {
            --bg-body:        #0F0F17;
            --bg-sidebar:     #0D0D15;
            --bg-card:        #1A1A26;
            --bg-surface:     #15151F;
            --bg-input:       #1E1E2C;
            --bg-hover:       #22222F;
            --bg-modal:       #1A1A26;
            --bg-header:      rgba(15,15,23,0.85);

            --border:         #2A2A3A;
            --border-subtle:  #222232;

            --text-primary:   #E8E8F0;
            --text-secondary: #9898AC;
            --text-muted:     #5C5C72;
            --text-inverse:   #0F0F17;

            --brand-bg:       rgba(110,80,247,0.12);
            --brand-text:     #A899FF;
            --brand-border:   rgba(110,80,247,0.25);
            --brand-solid:    #6E50F7;
            --brand-solid-h:  #7E64F8;

            --nav-active-bg:      rgba(110,80,247,0.14);
            --nav-active-text:    #C9BFFF;
            --nav-active-border:  rgba(110,80,247,0.3);
            --nav-text:           #7A7A92;
            --nav-hover-bg:       rgba(255,255,255,0.05);

            --shadow-sm:  0 1px 3px rgba(0,0,0,0.3);
            --shadow-md:  0 4px 16px rgba(0,0,0,0.4);
            --shadow-lg:  0 8px 32px rgba(0,0,0,0.5);
            --shadow-modal: 0 20px 60px rgba(0,0,0,0.6);

            --overlay:    rgba(0,0,0,0.6);
            color-scheme: dark;
        }

        /* ════════════════════════════════════════════
           BASE STYLES
           ════════════════════════════════════════════ */
        body {
            background: var(--bg-body);
            color: var(--text-primary);
        }

        /* Scrollbars */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }

        /* Selection */
        ::selection { background: var(--brand-bg); color: var(--brand-text); }

        /* ════════════════════════════════════════════
           SIDEBAR NAV LINKS
           ════════════════════════════════════════════ */
        .nav-link {
            display: flex; align-items: center; gap: 10px;
            padding: 9px 14px; border-radius: 8px;
            font-size: 13.5px; font-weight: 600;
            color: var(--nav-text);
            border: 1px solid transparent;
            transition: all 0.15s ease;
            text-decoration: none;
        }
        .nav-link svg { flex-shrink: 0; }
        .nav-link:hover {
            color: var(--text-primary);
            background: var(--nav-hover-bg);
        }
        .nav-link.active {
            color: var(--nav-active-text);
            background: var(--nav-active-bg);
            border-color: var(--nav-active-border);
        }

        /* ════════════════════════════════════════════
           COMMON UI COMPONENTS
           ════════════════════════════════════════════ */
        .ev-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: var(--shadow-sm);
        }
        .ev-card:hover {
            border-color: var(--brand-border);
            box-shadow: var(--shadow-md);
        }

        .ev-input {
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-primary);
            padding: 8px 14px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.15s;
        }
        .ev-input::placeholder { color: var(--text-muted); }
        .ev-input:focus { border-color: var(--brand-solid); }

        .ev-select {
            background: var(--bg-input);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text-primary);
            padding: 6px 12px;
            font-size: 14px;
            outline: none;
            cursor: pointer;
            transition: border-color 0.15s;
        }
        .ev-select:focus { border-color: var(--brand-solid); }

        .ev-btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 6px;
            padding: 10px 20px; border-radius: 8px;
            font-size: 14px; font-weight: 600;
            border: none; cursor: pointer;
            transition: all 0.15s ease;
            text-decoration: none;
        }
        .ev-btn-primary {
            background: var(--brand-solid);
            color: #fff;
        }
        .ev-btn-primary:hover { background: var(--brand-solid-h); }
        .ev-btn-ghost {
            background: transparent;
            color: var(--text-primary);
            border: 1px solid var(--border);
        }
        .ev-btn-ghost:hover { background: var(--bg-hover); }

        .ev-badge {
            display: inline-flex; align-items: center; gap: 4px;
            padding: 3px 10px; border-radius: 6px;
            font-size: 11px; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.04em;
        }
        .ev-badge-brand {
            background: var(--brand-bg);
            color: var(--brand-text);
            border: 1px solid var(--brand-border);
        }

        .ev-modal-overlay {
            background: var(--overlay);
            backdrop-filter: blur(4px);
        }
        .ev-modal {
            background: var(--bg-modal);
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: var(--shadow-modal);
            color: var(--text-primary);
        }

        .ev-table th {
            background: var(--bg-surface);
            color: var(--text-secondary);
            border-bottom: 1px solid var(--border);
        }
        .ev-table td {
            border-bottom: 1px solid var(--border-subtle);
        }
        .ev-table tr:hover td {
            background: var(--bg-hover);
        }

        .text-primary   { color: var(--text-primary) !important; }
        .text-secondary  { color: var(--text-secondary) !important; }
        .text-muted      { color: var(--text-muted) !important; }
        .text-brand      { color: var(--brand-text) !important; }
        .bg-card         { background: var(--bg-card) !important; }
        .bg-surface      { background: var(--bg-surface) !important; }
        .border-theme    { border-color: var(--border) !important; }

        /* Theme toggle button */
        .theme-toggle {
            display: flex; align-items: center; gap: 8px;
            padding: 8px 12px; border-radius: 8px;
            cursor: pointer; border: none;
            background: var(--bg-surface);
            color: var(--text-secondary);
            font-size: 12px; font-weight: 600;
            transition: all 0.15s;
            width: 100%;
        }
        .theme-toggle:hover {
            background: var(--bg-hover);
            color: var(--text-primary);
        }
        .theme-toggle svg { width: 16px; height: 16px; flex-shrink: 0; }

        /* Fade in */
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .animate-fadeInUp { animation: fadeInUp 0.5s ease forwards; }
    </style>
</head>
<body class="min-h-screen antialiased">
    <th:block th:replace="${content}" />
    <div th:replace="~{components/confirm_modal :: modal}"></div>

    <!-- Theme toggle script -->
    <script>
        function toggleTheme() {
            var html = document.documentElement;
            var next = html.classList.contains('dark') ? 'light' : 'dark';
            html.className = next;
            localStorage.setItem('eventrio-theme', next);
            document.querySelectorAll('.theme-icon-light').forEach(el => el.style.display = next === 'light' ? 'none' : 'block');
            document.querySelectorAll('.theme-icon-dark').forEach(el => el.style.display = next === 'dark' ? 'none' : 'block');
        }
        document.addEventListener('DOMContentLoaded', function() {
            var t = document.documentElement.className;
            document.querySelectorAll('.theme-icon-light').forEach(el => el.style.display = t === 'light' ? 'none' : 'block');
            document.querySelectorAll('.theme-icon-dark').forEach(el => el.style.display = t === 'dark' ? 'none' : 'block');
        });
    </script>
</body>
</html>
</file>

<file path="eventrio-springboot/eventrio-web-service/src/main/resources/templates/browse_events.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" th:replace="~{base :: layout(~{::section})}">
<body>
<section th:fragment="section">
<div class="flex flex-col md:flex-row h-screen w-full overflow-hidden">
    <!-- Left Pane: Search and Event List (30% width on md screens) -->
    <aside class="w-full md:w-1/3 lg:w-1/4 bg-white border-r border-slate-200 flex flex-col h-full bg-white shadow-sm">
        <!-- Search Header -->
        <div class="p-6 border-b border-slate-100 space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="text-xl font-black text-slate-800 tracking-tight">Explore Events</h2>
                <a th:href="@{/}" class="text-xs font-bold text-brand-600 hover:text-brand-700 transition-colors uppercase tracking-widest">Home</a>
            </div>
            <div class="relative">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </span>
                <input type="text" placeholder="Search for events..." 
                    class="block w-full pl-10 pr-4 py-2 bg-white border border-slate-200 rounded-2xl focus:ring-brand-500 focus:border-brand-500 text-sm transition-all shadow-sm">
            </div>
        </div>

        <!-- Event List -->
        <div class="flex-grow overflow-y-auto p-4 space-y-4 bg-white/30">
            <th:block th:if="${events != null and !events.isEmpty()}">
                <th:block th:each="event : ${events}">
                <a th:href="@{/browse-events(selected=${event.id})}" 
                   class="block p-5 rounded-2xl transition-all cursor-pointer group" th:classappend="${(selected_event != null and selected_event.id == event.id) ? 'bg-white border-2 border-brand-500 shadow-lg ring-4 ring-brand-500/5 scale-[1.02]' : 'bg-white border border-slate-200 hover:border-slate-300 hover:shadow-md'}">
                    <div class="flex justify-between items-start mb-2">
                        <th:block th:if="${event.industry != null and !#strings.isEmpty(event.industry)}">
                            <span class="px-2 py-1 bg-brand-50 text-brand-600 text-[10px] font-black uppercase tracking-widest rounded-md border border-brand-100">[[${#strings.substring(event.industry,0,1)}]]</span>
                        </th:block><th:block th:unless="${event.industry != null and !#strings.isEmpty(event.industry)}">
                            <span class="px-2 py-1 bg-white text-slate-500 text-[10px] font-black uppercase tracking-widest rounded-md border border-slate-100 italic">GenAI</span>
                        </th:block>
                        <span class="text-[10px] text-slate-400 font-bold uppercase tracking-widest">[[${#temporals.format(event.startDate, 'MMM dd, yyyy')}]]</span>
                    </div>
                    <h3 class="text-lg font-black text-slate-800 leading-tight mb-2 transition-colors"
                        th:classappend="${!(selected_event != null and selected_event.id == event.id) ? 'group-hover:text-brand-600' : ''}">
                        [[${event.name}]]
                    </h3>
                    <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                        [[${(event.description ?: 'No description provided.')}]]
                    </p>
                    <div class="mt-3 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="text-[10px] text-slate-400 font-bold">Attendee Goal:</span>
                            <span class="text-[10px] text-brand-600 font-black">[[${event.attendeeCountExpected}]]</span>
                        </div>
                    </div>
                </a>
                </th:block>
            </th:block><th:block th:unless="${events == null or events.isEmpty()}">
                <div class="text-center py-12 px-6">
                    <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <h3 class="text-sm font-bold text-slate-800 uppercase tracking-widest mb-2">No Upcoming Events</h3>
                    <p class="text-xs text-slate-500 leading-relaxed">Check back later for new innovative gatherings.</p>
                </div>
            </th:block>
        </div>
    </aside>

    <!-- Right Pane: Event Details -->
    <main class="flex-grow overflow-y-auto bg-white flex flex-col relative">
        <th:block th:if="${selected_event != null}">
            <!-- Event Header Background -->
            <div class="h-64 md:h-80 relative w-full flex-shrink-0">
                <th:block th:if="${selected_event.mediaLinks != null and !selected_event.mediaLinks.isEmpty()}">
                    <img src="[[${selected_event.mediaLinks[0]}]]" class="w-full h-full object-cover" alt="Event Banner">
                </th:block><th:block th:unless="${selected_event.mediaLinks != null and !selected_event.mediaLinks.isEmpty()}">
                    <div class="w-full h-full bg-slate-900 flex items-center justify-center">
                        <div class="text-center">
                            <span class="text-brand-500 text-4xl block mb-2 opacity-50 font-black italic">Eventrio</span>
                            <span class="text-slate-500 text-xs font-bold uppercase tracking-widest">Media Pending</span>
                        </div>
                    </div>
                </th:block>
                <div class="absolute inset-0 bg-gradient-to-t from-white via-white/20 to-transparent"></div>
            </div>

            <!-- Content Container -->
            <div class="max-w-4xl mx-auto w-full px-6 md:px-12 pb-24 -mt-20 relative z-10">
                <div class="bg-white rounded-3xl p-8 md:p-12 shadow-premium shadow-slate-200/60 border border-slate-100">
                    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
                        <div>
                            <h1 class="text-4xl md:text-5xl font-black text-slate-800 tracking-tighter mb-4">[[${selected_event.name}]]</h1>
                            <div class="flex flex-wrap items-center gap-4 text-sm font-bold text-slate-500 uppercase tracking-widest">
                                <span class="flex items-center gap-2">
                                    <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                    [[${#temporals.format(selected_event.startDate, 'MMM dd, yyyy')}]]
                                </span>
                                <span class="flex items-center gap-2">
                                    <svg class="w-5 h-5 text-brand-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    [[${#temporals.format(selected_event.startDate, 'HH:mm')}]] - [[${selected_event.endDate != null ? #temporals.format(selected_event.endDate, 'HH:mm') : 'End TBD'}]]
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="prose prose-slate max-w-none mb-12">
                        <h2 class="text-xl font-black text-slate-800 uppercase tracking-widest mb-4">About the Event</h2>
                        <p class="text-slate-600 leading-relaxed text-lg">
                            [[${(selected_event.description ?: 'No detailed description available for this event yet.')}]]
                        </p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-12">
                        <!-- Topics to Discuss -->
                        <div>
                            <h2 class="text-xl font-black text-slate-800 uppercase tracking-widest mb-6">Key Topics</h2>
                            <ul class="flex flex-col gap-3 max-h-72 overflow-y-auto pr-2" style="scrollbar-width: thin; scrollbar-color: #cbd5e1 transparent;">
                                <th:block th:if="${selected_event.targetingPointsToDiscuss != null and !selected_event.targetingPointsToDiscuss.isEmpty()}">
                                    <th:block th:each="point : ${selected_event.targetingPointsToDiscuss}">
                                    <li class="flex items-start gap-3 p-3.5 bg-white rounded-2xl border border-slate-100 group hover:border-brand-300 hover:shadow-md transition-all">
                                        <div class="w-5 h-5 rounded-full border-2 border-brand-200 flex-shrink-0 mt-0.5 bg-brand-50 group-hover:bg-brand-500 group-hover:border-brand-500 transition-colors"></div>
                                        <div>
                                            <h4 class="font-bold text-slate-700 text-sm leading-snug group-hover:text-slate-900 transition-colors">
                                                <th:block th:if="${point instanceof T(java.util.Map) and point['topic'] != null}">
                                                    [[${point.get('topic')}]]
                                                </th:block><th:block th:if="${point instanceof T(java.util.Map) and point['point'] != null}" th:unless="${point instanceof T(java.util.Map) and point['topic'] != null}">
                                                    [[${point.get('point')}]]
                                                </th:block><th:block th:if="${point instanceof T(java.lang.String)}" th:unless="${point instanceof T(java.util.Map) and (point['topic'] != null or point['point'] != null)}">
                                                    [[${point}]]
                                                </th:block><th:block th:unless="${point instanceof T(java.util.Map) or point instanceof T(java.lang.String)}">
                                                    [[${point}]]
                                                </th:block>
                                            </h4>
                                        </div>
                                    </li>
                                    </th:block>
                                </th:block><th:block th:unless="${selected_event.targetingPointsToDiscuss != null and !selected_event.targetingPointsToDiscuss.isEmpty()}">
                                    <p class="text-sm text-slate-400 italic">No key topics published yet.</p>
                                </th:block>
                            </ul>
                        </div>

                        <!-- Organization Information -->
                        <div>
                            <h2 class="text-xl font-black text-slate-800 uppercase tracking-widest mb-6">Host Organization</h2>
                            <div class="bg-brand-900 text-white p-6 rounded-3xl shadow-premium ">
                                <h4 class="text-lg font-black tracking-tight mb-2">[[${selected_event.orgName}]]</h4>
                                <p class="text-[10px] opacity-70 uppercase font-black tracking-widest mb-4">Official Organizer</p>
                                <div class="flex items-center gap-3 text-sm opacity-80">
                                    <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                    [[${(selected_event.orgLocation ?: 'Location TBD')}]]
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Reserve Button Section -->
                    <div class="mt-16 pt-8 border-t border-slate-100 flex justify-center">
                        <button onclick="openReservationModal()" class="px-12 py-5 bg-brand-600 hover:bg-brand-500 text-white font-black text-xl rounded-2xl shadow-premium shadow-brand-200 transition-all duration-300 transform hover:-translate-y-1 active:scale-95">
                            Reserve Your Spot Now
                        </button>
                    </div>
                </div>
            </div>

            <!-- Reservation Modal -->
            <div id="reservationModal" class="fixed inset-0 z-[100] hidden">
                <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" onclick="closeReservationModal()"></div>
                <div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
                    <div class="bg-white w-full max-w-md rounded-3xl shadow-premium relative z-[101] overflow-hidden pointer-events-auto transform transition-all scale-95 opacity-0 duration-300" id="modalContent">
                        <!-- Step 1: Info -->
                        <div id="resStep1" class="p-8 md:p-10">
                            <h3 class="text-2xl font-black text-slate-800 tracking-tight mb-2">Reserve Your Spot</h3>
                            <p class="text-sm text-slate-500 mb-8 font-medium">We'll send a verification code to your email to confirm your reservation.</p>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1 ml-1">Full Name</label>
                                    <input type="text" id="resName" placeholder="Enter your name" class="w-full px-5 py-3 bg-white border border-slate-200 rounded-2xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all text-sm font-medium">
                                </div>
                                <div>
                                    <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-1 ml-1">Email Address</label>
                                    <input type="email" id="resEmail" placeholder="you@example.com" class="w-full px-5 py-3 bg-white border border-slate-200 rounded-2xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all text-sm font-medium">
                                </div>
                                <button onclick="sendVerificationCode()" id="btnSendCode" class="w-full py-4 bg-brand-600 hover:bg-brand-500 text-white font-black rounded-2xl shadow-lg shadow-brand-500/20 transition-all active:scale-95 mt-4">
                                    Send Verification Code
                                </button>
                            </div>
                        </div>

                        <!-- Step 2: Code -->
                        <div id="resStep2" class="p-8 md:p-10 hidden">
                            <button onclick="backToStep1()" class="mb-4 text-xs font-bold text-brand-600 flex items-center gap-1 hover:underline">
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 19l-7-7 7-7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
                                Back
                            </button>
                            <h3 class="text-2xl font-black text-slate-800 tracking-tight mb-2">Verify Email</h3>
                            <p class="text-sm text-slate-500 mb-8 font-medium">Enter the 6-digit code we sent to your inbox.</p>
                            <div class="space-y-6">
                                <div class="flex justify-center">
                                    <input type="text" id="resCode" maxlength="6" placeholder="000000" class="w-full max-w-[200px] text-center text-3xl font-black tracking-[0.5em] py-4 bg-white border-2 border-slate-100 rounded-2xl focus:border-brand-500 focus:ring-0 transition-all">
                                </div>
                                <button onclick="completeReservation()" id="btnVerify" class="w-full py-4 bg-brand-800 hover:bg-brand-900 text-white font-black rounded-2xl shadow-premium transition-all active:scale-95">
                                    Confirm Reservation
                                </button>
                            </div>
                        </div>

                        <!-- Success State -->
                        <div id="resSuccess" class="p-8 md:p-10 text-center hidden">
                            <div class="w-20 h-20 bg-green-50 rounded-full flex items-center justify-center mx-auto mb-6">
                                <svg class="w-10 h-10 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <h3 class="text-2xl font-black text-slate-800 tracking-tight mb-2">You're In!</h3>
                            <p class="text-sm text-slate-500 mb-8 font-medium">Your reservation has been confirmed. Check your email for details.</p>
                            <button onclick="closeReservationModal()" class="w-full py-4 bg-slate-900 text-white font-black rounded-2xl hover:bg-slate-800 transition-all active:scale-95">
                                Great, thanks!
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                const modal = document.getElementById('reservationModal');
                const modalContent = document.getElementById('modalContent');
                const step1 = document.getElementById('resStep1');
                const step2 = document.getElementById('resStep2');
                const success = document.getElementById('resSuccess');

                function openReservationModal() {
                    modal.classList.remove('hidden');
                    setTimeout(() => {
                        modalContent.classList.remove('scale-95', 'opacity-0');
                        modalContent.classList.add('scale-100', 'opacity-100');
                    }, 50);
                }

                function closeReservationModal() {
                    modalContent.classList.add('scale-95', 'opacity-0');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                        resetModal();
                    }, 300);
                }

                function resetModal() {
                    step1.classList.remove('hidden');
                    step2.classList.add('hidden');
                    success.classList.add('hidden');
                    document.getElementById('resCode').value = '';
                }

                function backToStep1() {
                    step2.classList.add('hidden');
                    step1.classList.remove('hidden');
                }

                async function sendVerificationCode() {
                    const email = document.getElementById('resEmail').value;
                    const name = document.getElementById('resName').value;
                    const btn = document.getElementById('btnSendCode');

                    if (!email || !name) {
                        alert('Please fill in both name and email.');
                        return;
                    }

                    btn.disabled = true;
                    btn.innerText = 'Sending...';

                    try {
                        const response = await fetch(`/customer/get-verification-code/${email}`);
                        const data = await response.json();

                        if (response.ok) {
                            step1.classList.add('hidden');
                            step2.classList.remove('hidden');
                        } else {
                            alert(data.message || 'Failed to send code.');
                        }
                    } catch (error) {
                        alert('Error sending verification code.');
                    } finally {
                        btn.disabled = false;
                        btn.innerText = 'Send Verification Code';
                    }
                }

                async function completeReservation() {
                    const code = document.getElementById('resCode').value;
                    const email = document.getElementById('resEmail').value;
                    const name = document.getElementById('resName').value;
                    const btn = document.getElementById('btnVerify');

                    if (!code || code.length !== 6) {
                        alert('Please enter the 6-digit code.');
                        return;
                    }

                    btn.disabled = true;
                    btn.innerText = 'Verifying...';

                    const payload = {
                        name: name,
                        email: email,
                        eventID: '[[${selected_event.id}]]',
                        orgID: '[[${selected_event.orgID}]]',
                        verificationCode: code
                    };

                    try {
                        const response = await fetch('/customer/verify-user', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        const data = await response.json();

                        if (response.ok) {
                            step2.classList.add('hidden');
                            success.classList.remove('hidden');
                        } else {
                            alert(data.message || 'Verification failed.');
                        }
                    } catch (error) {
                        alert('Error confirming reservation.');
                    } finally {
                        btn.disabled = false;
                        btn.innerText = 'Confirm Reservation';
                    }
                }
            </script>
        </th:block><th:block th:unless="${selected_event == null}">
            <!-- No Selection State -->
            <div class="flex-grow flex items-center justify-center p-12 text-center">
                <div class="max-w-md">
                    <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-10 h-10 text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                    <h2 class="text-2xl font-black text-slate-800 tracking-tight mb-2">Select an event</h2>
                    <p class="text-slate-500 font-medium">Choose an event from the list to view its full schedule and registration details.</p>
                </div>
            </div>
        </th:block>
    </main>
</div>

</section>
</body>
</html>
</file>

<file path="eventrio-springboot/eventrio-web-service/src/main/resources/templates/dashboard.html">
<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" th:replace="~{base :: layout(~{::section})}">
<body>
<section th:fragment="section">
<div class="flex h-screen w-full overflow-hidden" style="background:var(--bg-body);">

    <!-- ═══ SIDEBAR ═══ -->
    <aside class="w-60 flex-shrink-0 hidden md:flex flex-col" style="background:var(--bg-sidebar); border-right:1px solid var(--border);">
        <div class="h-16 flex items-center px-5 gap-3" style="border-bottom:1px solid var(--border);">
            <div class="w-8 h-8 rounded-xl flex items-center justify-center" style="background:var(--brand-solid);">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <span class="text-base font-extrabold tracking-tight" style="color:var(--text-primary);">Eventrio</span>
        </div>
        <nav class="flex-1 px-3 py-5 space-y-1">
            <a th:href="@{/dashboard(tab=engagement)}" class="nav-link" th:classappend="${(active_tab == 'engagement') ? 'active' : ''}">
                <svg style="width:18px;height:18px;flex-shrink:0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                Engagement
            </a>
            <a th:href="@{/ai-planner}" class="nav-link" th:classappend="${(active_tab == 'ai-planner') ? 'active' : ''}">
                <svg style="width:18px;height:18px;flex-shrink:0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0012 18.75c-1.03 0-1.9-.4-2.593-1.003l-.548-.547z"/></svg>
                AI Planner
            </a>
            <a th:href="@{/dashboard(tab=orgs)}" class="nav-link" th:classappend="${(active_tab == 'orgs'  or  active_tab == 'Organizations') ? 'active' : ''}">
                <svg style="width:18px;height:18px;flex-shrink:0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                Organizations
            </a>
            <a th:href="@{/dashboard(tab=collabs)}" class="nav-link" th:classappend="${(active_tab == 'collabs') ? 'active' : ''}">
                <svg style="width:18px;height:18px;flex-shrink:0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                Invitations
            </a>
            <a th:href="@{/dashboard(tab=profile)}" class="nav-link" th:classappend="${(active_tab == 'profile') ? 'active' : ''}">
                <svg style="width:18px;height:18px;flex-shrink:0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                Profile
            </a>
            <a th:href="@{/dashboard(tab=social_setup)}" class="nav-link" th:classappend="${(active_tab == 'social_setup') ? 'active' : ''}">
                <svg style="width:18px;height:18px;flex-shrink:0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                Social Setup
            </a>
            <a th:href="@{/dashboard(tab=settings)}" class="nav-link" th:classappend="${(active_tab == 'settings') ? 'active' : ''}">
                <svg style="width:18px;height:18px;flex-shrink:0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Settings
            </a>
        </nav>
        <!-- Bottom: theme toggle -->
        <div class="p-3" style="border-top:1px solid var(--border);">
            <button onclick="toggleTheme()" class="theme-toggle">
                <!-- Sun icon (show in dark mode to switch to light) -->
                <svg class="theme-icon-light" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707M16.95 16.95l.707.707M7.05 7.05l.707.707M12 8a4 4 0 100 8 4 4 0 000-8z"/></svg>
                <!-- Moon icon (show in light mode to switch to dark) -->
                <svg class="theme-icon-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
                <span>Toggle Theme</span>
            </button>
        </div>
    </aside>

    <!-- Content Area -->
    <main class="flex-1 flex flex-col" th:classappend="${(active_tab == 'engagement') ? 'overflow-hidden h-screen' : 'overflow-y-auto w-full'}" style="background:var(--bg-body);">
        <th:block th:if="${active_tab != 'engagement'}">
        <header class="h-16 flex items-center px-8 sticky top-0 z-10" style="background:var(--bg-header); backdrop-filter:blur(12px); border-bottom:1px solid var(--border);">
            <h1 class="text-lg font-bold capitalize" style="color:var(--text-primary);">[[${active_tab}]]</h1>
        </header>
        </th:block>

        <div class="" th:classappend="${(active_tab == 'engagement') ? 'h-full' : 'p-8 pb-20'}" style="color:var(--text-primary);">
            <th:block th:if="${active_tab == 'orgs'}">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
                <h2 class="text-2xl font-bold text-slate-800">Your Organizations</h2>

                <div class="flex-1 max-w-md relative group">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <svg class="h-5 w-5 text-slate-400 group-focus-within:text-brand-500 transition-colors"
                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                    <input type="text" id="orgSearchInput" oninput="filterOrganizations()"
                        placeholder="Search by name or industry..."
                        class="block w-full pl-10 pr-3 py-2 border border-slate-200 rounded-lg bg-white text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent transition-all sm:text-sm shadow-sm">
                </div>

                <button onclick="openCreateOrgModal()"
                    class="bg-brand-600 hover:bg-brand-500 text-white px-4 py-2 rounded-lg font-semibold transition-all duration-200 flex items-center gap-2 shadow-md hover:shadow-premium-hover whitespace-nowrap">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Create Organization
                </button>
            </div>

            <div id="orgGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <th:block th:each="org : ${orgs}">
                <div th:data-org-id="${org.id}" th:data-org-name="${org.orgName}" th:data-org-industry="${org.industry}"
                    onclick="openEventsModal(this.dataset.orgId, this.dataset.orgName)"
                    class="org-card bg-white border border-slate-200 rounded-2xl p-6 hover:border-brand-500 hover:shadow-premium hover:shadow-premium-hover cursor-pointer transition-all duration-300 flex flex-col gap-4 group relative overflow-hidden shadow-sm">

                    <div
                        class="absolute top-0 right-0 p-2 text-[10px] font-bold bg-slate-100 rounded-bl-lg text-slate-500 uppercase tracking-tighter z-10">
                        [[${org.industry}]]
                    </div>

                    <div class="flex justify-between items-start mt-2 gap-4">
                        <div class="flex-1 min-w-0">
                            <h3 class="text-lg font-bold text-slate-800 group-hover:text-brand-600 transition-colors truncate"
                                title="[[${org.orgName}]]">
                                [[${org.orgName}]]
                            </h3>
                            <div class="text-slate-500 text-sm flex items-center gap-2 mt-1">
                                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                                    </path>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                                <span class="truncate">[[${org.address}]]</span>
                            </div>
                        </div>

                        <div class="relative z-30 flex-shrink-0">
                            <button th:attr="onclick=|event.stopPropagation(); toggleOrgMenu('${org.id}')|"
                                class="p-1.5 text-slate-400 hover:text-brand-600 hover:bg-slate-100 rounded-md transition-all">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z">
                                    </path>
                                </svg>
                            </button>
                            <div th:id="|menu-${org.id}|"
                                class="hidden absolute right-0 top-full mt-1 w-32 bg-white border border-slate-200 rounded-lg shadow-lg overflow-hidden py-1">
                                <button
                                    th:attr="onclick=|event.stopPropagation(); showUpdateOrgModal('${org.id}', '${#strings.escapeJavaScript(org.orgName)}', '${#strings.escapeJavaScript(org.address)}', '${#strings.escapeJavaScript(org.industry)}', '${#strings.escapeJavaScript(org.userRole)}')|"
                                    class="w-full px-4 py-2 text-left text-sm text-slate-700 hover:bg-white flex items-center gap-2 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                        </path>
                                    </svg>
                                    Update
                                </button>
                                <button
                                    th:attr="onclick=|event.stopPropagation(); showConfirmDeleteOrg('${org.id}', '${#strings.escapeJavaScript(org.orgName)}')|"
                                    class="w-full px-4 py-2 text-left text-sm text-red-600 hover:bg-red-50 flex items-center gap-2 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                        </path>
                                    </svg>
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="mt-auto pt-4 border-t border-slate-100 flex justify-between items-center text-xs">
                        <span class="px-2 py-1 bg-brand-100 text-brand-800 font-semibold rounded font-bold uppercase tracking-wider">[[${org.userRole}]]</span>
                        <span
                            class="text-brand-600 font-semibold group-hover:translate-x-1 transition-transform flex items-center gap-1">View
                            Events &rarr;</span>
                    </div>
                </div>
                </th:block>
            </div>

            <div id="noResults"
                class="hidden flex flex-col items-center justify-center py-20 bg-white border border-dashed border-slate-200 rounded-2xl">
                <svg class="w-16 h-16 text-slate-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                <p class="text-slate-500 text-lg font-medium">No organizations found matching your search.</p>
                <button onclick="clearSearch()" class="mt-4 text-brand-600 font-bold hover:underline">Clear
                    search</button>
            </div>

            <!-- Action buttons (removed and moved to header/top area) -->

            <!-- Modal for Events -->
            <div id="eventsModal"
                class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
                <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-lg shadow-premium scale-95 opacity-0 transition-all duration-200"
                    id="eventsModalContent">
                    <div class="p-6 border-b border-slate-200 flex justify-between items-center">
                        <h3 class="text-xl font-bold text-slate-800" id="modalOrgName">Events</h3>
                        <button onclick="closeEventsModal()"
                            class="text-slate-400 hover:text-slate-600 p-1 rounded-md hover:bg-slate-100 transition-colors">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                    <div class="p-6 space-y-3 max-h-[60vh] overflow-y-auto" id="eventsList">
                        <!-- Events injected via JS -->
                        <div class="flex items-center justify-center py-8 text-slate-500">
                            <svg class="animate-spin h-6 w-6 mr-3 text-brand-500" viewBox="0 0 24 24" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor"
                                    stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor"
                                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
                                </path>
                            </svg>
                            Loading events...
                        </div>
                    </div>
                </div>
            </div>
            <script>
                function filterOrganizations() {
                    const query = document.getElementById('orgSearchInput').value.toLowerCase();
                    const grid = document.getElementById('orgGrid');
                    const cards = grid.getElementsByClassName('org-card');
                    const noResults = document.getElementById('noResults');
                    let hasResults = false;

                    Array.from(cards).forEach(card => {
                        const name = card.getAttribute('data-org-name').toLowerCase();
                        const industry = card.getAttribute('data-org-industry').toLowerCase();

                        if (name.includes(query) || industry.includes(query)) {
                            card.classList.remove('hidden');
                            hasResults = true;
                        } else {
                            card.classList.add('hidden');
                        }
                    });

                    if (hasResults) {
                        grid.classList.remove('hidden');
                        grid.classList.add('grid');
                        noResults.classList.add('hidden');
                    } else {
                        grid.classList.remove('grid');
                        grid.classList.add('hidden');
                        noResults.classList.remove('hidden');
                    }
                }

                function clearSearch() {
                    document.getElementById('orgSearchInput').value = '';
                    filterOrganizations();
                }

                function openCreateOrgModal() {
                    const modal = document.getElementById('createOrgModal');
                    const modalContent = document.getElementById('createOrgModalContent');
                    modal.classList.remove('hidden');
                    setTimeout(() => {
                        modalContent.classList.remove('scale-95', 'opacity-0');
                        modalContent.classList.add('scale-100', 'opacity-100');
                    }, 10);
                }

                function closeCreateOrgModal() {
                    const modal = document.getElementById('createOrgModal');
                    const modalContent = document.getElementById('createOrgModalContent');
                    modalContent.classList.add('scale-95', 'opacity-0');
                    modalContent.classList.remove('scale-100', 'opacity-100');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                    }, 200);
                }

                function saveOrg() {
                    const orgName = document.getElementById('newOrgName').value;
                    const address = document.getElementById('newOrgAddress').value;
                    const industry = document.getElementById('newOrgIndustry').value;
                    const userRole = document.getElementById('newOrgRole').value;

                    if (!orgName) {
                        alert("Please enter an organization name");
                        return;
                    }

                    fetch('/main-dashboard/create-org', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            orgName: orgName,
                            address: address,
                            industry: industry,
                            userRole: userRole
                        })
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.message === "Success") {
                                window.location.reload();
                            } else {
                                alert("Failed to create org: " + (data.data || "Unknown error"));
                            }
                        })
                        .catch(err => {
                            alert("An error occurred. Please try again.");
                            console.error(err);
                        });
                }

                function openEventsModal(orgId, orgName) {
                    const modal = document.getElementById('eventsModal');
                    const modalContent = document.getElementById('eventsModalContent');
                    document.getElementById('modalOrgName').innerText = orgName + ' Events';

                    modal.classList.remove('hidden');
                    setTimeout(() => {
                        modalContent.classList.remove('scale-95', 'opacity-0');
                        modalContent.classList.add('scale-100', 'opacity-100');
                    }, 10);

                    fetch(`/main-dashboard/get-org-projects/${orgId}`)
                        .then(res => res.json())
                        .then(data => {
                            const list = document.getElementById('eventsList');
                            list.innerHTML = '';
                            if (data.length === 0) {
                                list.innerHTML = '<p class="text-gray-500 text-center py-8">No events found.</p>';
                            } else {
                                data.forEach(event => {
                                    list.innerHTML += `
                                            <a href="/event-dashboard/${event.id}" target="_blank" class="block p-4 bg-white border border-slate-100 rounded-lg hover:border-brand-500 transition-all group">
                                                <div class="flex justify-between items-start">
                                                    <div>
                                                        <h4 class="font-bold text-slate-800 text-md group-hover:text-brand-600 transition-colors">${event.name}</h4>
                                                        <div class="text-xs border-t border-slate-200 mt-2 pt-2 flex flex-wrap items-center gap-3">
                                                            <span class="text-slate-500 flex items-center gap-1">${event.date}</span>
                                                            <span class="px-1.5 py-0.5 bg-slate-200 text-slate-600 rounded text-[10px] font-bold uppercase">${event.status}</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </a>
                                        `;
                                });
                            }
                        });
                }

                function closeEventsModal() {
                    const modal = document.getElementById('eventsModal');
                    const modalContent = document.getElementById('eventsModalContent');
                    modalContent.classList.add('scale-95', 'opacity-0');
                    modalContent.classList.remove('scale-100', 'opacity-100');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                    }, 200);
                }

                let activeOrgMenu = null;

                function toggleOrgMenu(orgId) {
                    const menu = document.getElementById(`menu-${orgId}`);
                    if (activeOrgMenu && activeOrgMenu !== menu) {
                        activeOrgMenu.classList.add('hidden');
                    }
                    menu.classList.toggle('hidden');
                    activeOrgMenu = menu.classList.contains('hidden') ? null : menu;
                }

                // Close menus when clicking anywhere
                document.addEventListener('click', () => {
                    if (activeOrgMenu) {
                        activeOrgMenu.classList.add('hidden');
                        activeOrgMenu = null;
                    }
                });

                function showUpdateOrgModal(orgId, orgName, address, industry, role) {
                    document.getElementById('updateOrgId').value = orgId;
                    document.getElementById('updateOrgName').value = orgName;
                    document.getElementById('updateOrgAddress').value = address;
                    document.getElementById('updateOrgIndustry').value = industry;
                    document.getElementById('updateOrgRole').value = role;

                    const modal = document.getElementById('updateOrgModal');
                    const modalContent = document.getElementById('updateOrgModalContent');
                    modal.classList.remove('hidden');
                    setTimeout(() => {
                        modalContent.classList.remove('scale-95', 'opacity-0');
                        modalContent.classList.add('scale-100', 'opacity-100');
                    }, 10);
                }

                function closeUpdateOrgModal() {
                    const modal = document.getElementById('updateOrgModal');
                    const modalContent = document.getElementById('updateOrgModalContent');
                    modalContent.classList.add('scale-95', 'opacity-0');
                    modalContent.classList.remove('scale-100', 'opacity-100');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                    }, 200);
                }

                function saveUpdatedOrg() {
                    const orgId = document.getElementById('updateOrgId').value;
                    const orgName = document.getElementById('updateOrgName').value;
                    const address = document.getElementById('updateOrgAddress').value;
                    const industry = document.getElementById('updateOrgIndustry').value;
                    const userRole = document.getElementById('updateOrgRole').value;

                    if (!orgName) {
                        alert("Please enter an organization name");
                        return;
                    }

                    fetch(`/main-dashboard/update-org/${orgId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            orgName: orgName,
                            address: address,
                            industry: industry,
                            userRole: userRole
                        })
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.message === "Success") {
                                window.location.reload();
                            } else {
                                alert("Failed to update org: " + (data.data || "Unknown error"));
                            }
                        })
                        .catch(err => {
                            alert("An error occurred. Please try again.");
                            console.error(err);
                        });
                }

                function showConfirmDeleteOrg(orgId, orgName) {
                    openConfirmModal(
                        'Delete Organization',
                        `Are you sure you want to delete "${orgName}"? This will also delete all associated projects, posts, and participants. This action cannot be undone.`,
                        'Delete',
                        () => removeOrg(orgId),
                        'danger'
                    );
                }

                function removeOrg(orgId) {
                    fetch(`/main-dashboard/remove-org/${orgId}`, {
                        method: 'DELETE'
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.message === "success") {
                                // Find and remove the card from UI
                                const card = document.querySelector(`[data-org-id="${orgId}"]`);
                                if (card) {
                                    card.style.opacity = '0';
                                    card.style.transform = 'scale(0.9)';
                                    setTimeout(() => card.remove(), 200);
                                } else {
                                    window.location.reload();
                                }
                            } else {
                                alert("Failed to remove organization: " + (data.data || "Unknown error"));
                            }
                        })
                        .catch(err => {
                            console.error(err);
                            alert("An error occurred while deleting the organization.");
                        });
                }
            </script>

            <!-- Modal for Create Org -->
            <div id="createOrgModal"
                class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
                <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-lg shadow-premium scale-95 opacity-0 transition-all duration-200"
                    id="createOrgModalContent">
                    <div class="p-6 border-b border-slate-200 flex justify-between items-center">
                        <h3 class="text-xl font-bold text-slate-800">Create Organization</h3>
                        <button onclick="closeCreateOrgModal()"
                            class="text-slate-400 hover:text-slate-600 p-1 rounded-md hover:bg-slate-100 transition-colors">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                    <div class="p-6 space-y-4">
                        <div>
                            <label
                                class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Organization
                                Name</label>
                            <input id="newOrgName" type="text" placeholder="e.g. Acme Corp"
                                class="w-full bg-white border border-slate-200 rounded-md px-4 py-2 text-slate-800 focus:ring-2 focus:ring-brand-500 outline-none transition-all">
                        </div>
                        <div>
                            <label
                                class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Address</label>
                            <input id="newOrgAddress" type="text" placeholder="e.g. 123 Main St"
                                class="w-full bg-white border border-slate-200 rounded-md px-4 py-2 text-slate-800 focus:ring-2 focus:ring-brand-500 outline-none transition-all">
                        </div>
                        <div>
                            <label
                                class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Industry</label>
                            <select id="newOrgIndustry"
                                class="w-full bg-white border border-slate-200 rounded-md px-4 py-2 text-slate-800 focus:ring-2 focus:ring-brand-500 outline-none transition-all">
                                <th:block th:each="industry : ${industries}">
                                <option value="[[${industry}]]">[[${industry}]]</option>
                                </th:block>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Your
                                Role</label>
                            <select id="newOrgRole"
                                class="w-full bg-white border border-slate-200 rounded-md px-4 py-2 text-slate-800 focus:ring-2 focus:ring-brand-500 outline-none transition-all">
                                <th:block th:each="role : ${roles}">
                                <option value="[[${role}]]">[[${role}]]</option>
                                </th:block>
                            </select>
                        </div>
                        <button onclick="saveOrg()"
                            class="w-full bg-brand-500 hover:bg-brand-600 text-white font-bold py-2.5 rounded-md transition-all shadow-sm">Save
                            Organization</button>
                    </div>
                </div>
            </div>

            <!-- Modal for Update Org -->
            <div id="updateOrgModal"
                class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
                <div class="bg-white border border-slate-200 rounded-2xl w-full max-w-lg shadow-premium scale-95 opacity-0 transition-all duration-200"
                    id="updateOrgModalContent">
                    <div class="p-6 border-b border-slate-200 flex justify-between items-center">
                        <h3 class="text-xl font-bold text-slate-800">Update Organization</h3>
                        <button onclick="closeUpdateOrgModal()"
                            class="text-slate-400 hover:text-slate-600 p-1 rounded-md hover:bg-slate-100 transition-colors">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                    <div class="p-6 space-y-4">
                        <input type="hidden" id="updateOrgId">
                        <div>
                            <label
                                class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Organization
                                Name</label>
                            <input id="updateOrgName" type="text" placeholder="e.g. Acme Corp"
                                class="w-full bg-white border border-slate-200 rounded-md px-4 py-2 text-slate-800 focus:ring-2 focus:ring-brand-500 outline-none transition-all">
                        </div>
                        <div>
                            <label
                                class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Address</label>
                            <input id="updateOrgAddress" type="text" placeholder="e.g. 123 Main St"
                                class="w-full bg-white border border-slate-200 rounded-md px-4 py-2 text-slate-800 focus:ring-2 focus:ring-brand-500 outline-none transition-all">
                        </div>
                        <div>
                            <label
                                class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Industry</label>
                            <select id="updateOrgIndustry"
                                class="w-full bg-white border border-slate-200 rounded-md px-4 py-2 text-slate-800 focus:ring-2 focus:ring-brand-500 outline-none transition-all">
                                <th:block th:each="industry : ${industries}">
                                <option value="[[${industry}]]">[[${industry}]]</option>
                                </th:block>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Your
                                Role</label>
                            <select id="updateOrgRole"
                                class="w-full bg-white border border-slate-200 rounded-md px-4 py-2 text-slate-800 focus:ring-2 focus:ring-brand-500 outline-none transition-all">
                                <th:block th:each="role : ${roles}">
                                <option value="[[${role}]]">[[${role}]]</option>
                                </th:block>
                            </select>
                        </div>
                        <button onclick="saveUpdatedOrg()"
                            class="w-full bg-brand-500 hover:bg-brand-600 text-white font-bold py-2.5 rounded-md transition-all shadow-sm">Update
                            Organization</button>
                    </div>
                </div>
            </div>
