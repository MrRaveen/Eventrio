                            status...</div>
                        <button disabled
                            class="mt-auto px-6 py-2 bg-slate-200 text-slate-500 font-bold rounded-lg w-full cursor-not-allowed">Coming
                            Soon</button>
                    </div>
                </div>

                <script>
                    // Load social status
                    document.addEventListener('DOMContentLoaded', () => {
                        fetch('/main-dashboard/social-status')
                            .then(res => res.json())
                            .then(data => {
                                if (data.error) {
                                    console.error(data.error);
                                    return;
                                }

                                const platforms = ['facebook', 'linkedIn', 'youtube', 'pinterest'];
                                platforms.forEach(platform => {
                                    const statusDiv = document.getElementById(`status-${platform}`);
                                    if (statusDiv) {
                                        statusDiv.classList.remove('animate-pulse');
                                        if (data[platform]) {
                                            statusDiv.innerHTML = '<span class="text-emerald-500 font-bold flex items-center gap-1 justify-center"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Connected</span>';
                                        } else {
                                            statusDiv.innerHTML = '<span class="text-slate-400">Not Connected</span>';
                                        }
                                    }
                                });
                            })
                            .catch(err => console.error("Error fetching social status:", err));
                    });
                </script>
            </div>

            </th:block><th:block th:if="${active_tab == 'profile'}" th:unless="${(active_tab == 'orgs') or (active_tab == 'collabs') or (active_tab == 'engagement') or (active_tab == 'settings') or (active_tab == 'social_setup')}">
            <div class="max-w-2xl bg-white p-8 rounded-2xl border border-slate-200 flex flex-col gap-8 shadow-sm">
